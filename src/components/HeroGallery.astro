---
// Home section 1 (DESIGN_BRIEF.md 5.1). Array-driven: a one-item array gives
// a static hero for free (BUILD-PLAN.md), which is the real state today —
// see IMAGE-MANIFEST.md for the single available hero photo. Cross-dissolve
// cycling (6.1) and the opening line's sessionStorage timing (5.1) live in
// motion.js's initHeroGallery().
//
// No headline block, no descriptor paragraph (5.1's own rule) — the
// keyword-bearing <h1> lives as a visually-hidden element in index.astro,
// not here. "Amy K Clark Design" below is a styled paragraph, not a heading.

import RevealImage from './RevealImage.astro';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  blurDataURL?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section class="hero on-dark" data-hero>
  <div class="hero__gallery" data-hero-gallery data-single-image={images.length === 1 ? '' : undefined}>
    {images.map((image, i) => (
      <div class:list={['hero__layer', { 'is-active': i === 0 }]} data-hero-layer>
        <RevealImage
          src={image.src}
          alt={image.alt}
          blurDataURL={image.blurDataURL}
          fill
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content wrap">
    {/* The location block that used to sit here ("Cincinnati/NKY Based" /
        "Serving all areas") was removed in step 9b (2026-07-31 review). It was
        the only text competing with the photograph, and the hero's whole job
        is the photograph. Geography now lives as one line in the footer —
        DESIGN_BRIEF 5.1 and 5.8. The empty div keeps the three-row grid
        (auto / 1fr / auto) that centres the wordmark; without it the mark
        rides high. */}
    <div aria-hidden="true"></div>

    {/* The centre row now carries only the opening line — a transient element
        that fades out after ~3.8s and is then removed from the DOM. The
        wordmark moved OUT of here in step 10a: white type in the dead centre
        of the frame sat on the lightest part of the photograph (a pale wall,
        in every hero crop this site has used), and the middle of the mark
        disappeared into it entirely. See `.hero__mark` below. */}
    <div class="hero__center">
      <p class="hero__opening-line" data-hero-opening-line>The little details make all the difference.</p>
    </div>

    <div class="hero__bottom">
      <p class="hero__mark">Amy K Clark Design</p>
      <nav class="hero__words" aria-label="Featured categories">
        <a href="/services/upholstery" class="type-label link-underline">Upholstery</a>
        <a href="/services/drapery" class="type-label link-underline">Drapery</a>
        <a href="/services/blinds-shades" class="type-label link-underline">Shades</a>
      </nav>
      {/* One CTA, not two (5.1, 2026-07-31 review). The secondary "View
          Portfolio" button is gone: the Portfolio section is the very next
          thing on the page and carries its own link, and two buttons in one
          viewport split the click rather than doubling it.
          TODO (backend, pending): this points at /contact until the calendar
          booking tool for the discovery call is chosen — Calendly vs Google
          Calendar is an open question with Amy (ASK-AMY.md). When it lands,
          this href becomes the booking link. */}
      <div class="hero__ctas">
        <a href="/contact" class="btn btn-solid">Schedule your complimentary discovery call</a>
      </div>
      <div class="hero__scroll-cue" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: var(--paper);
  }

  .hero__gallery {
    position: absolute;
    inset: 0;
  }

  /* 6.1 cross-dissolve: opacity only, no sliding. Brightness pulse on the
     outgoing layer and continuous slow scale both live here rather than on
     RevealImage's own element, so they don't fight the reveal's one-time
     settle transform (translateY + scale) on the same property. */
  .hero__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--hero-dissolve) ease;
    animation: hero-slow-scale calc(var(--hero-hold) + var(--hero-dissolve)) linear infinite;
  }
  .hero__layer.is-active {
    opacity: 1;
    z-index: 1;
  }
  .hero__layer.is-leaving {
    animation:
      hero-slow-scale calc(var(--hero-hold) + var(--hero-dissolve)) linear infinite,
      hero-brightness-pulse var(--hero-dissolve) ease;
  }

  /* 6.1's continuous scale runs "across its full cycle" — a cycle being one
     hold plus one dissolve, ending when this layer hands off to the next.
     With a one-item array there is no handoff, so the animation just looped
     against itself: it ran 1.0 to 1.055 over 7.9s and then snapped back to
     1.0, over and over, for as long as the page stayed open. Gated on the
     real array length rather than removed, so it comes back on its own the
     moment a second photo lands and there is an actual cycle to run across.
     The JS half is already gated the same way (motion.js's initHeroGallery
     returns early below two layers). */
  .hero__gallery[data-single-image] .hero__layer {
    animation: none;
  }

  @keyframes hero-slow-scale {
    from { transform: scale(1); }
    to { transform: scale(1.055); }
  }
  @keyframes hero-brightness-pulse {
    0% { filter: brightness(1); }
    50% { filter: brightness(1.06); }
    100% { filter: brightness(1); }
  }

  /* 5.1 asks for "a subtle scrim gradient rather than a hard overlay so the
     image stays clean," and step 8's audit confirmed this is the ONE gradient
     in the whole bundle (3.2 bans them otherwise). It stays one gradient —
     the bottom ramp below is deepened, not supplemented with a second layer.

     Why the bottom got heavier in step 10a: the wordmark, the three word
     links, and the CTA now all sit in the lower third, and every hero
     photograph this site has used is LIGHT down there (a pale sofa and a
     stone floor in the current one). The old ramp reached only 55% ground at
     the very bottom edge and was still fully transparent at 55% height, so
     the band the wordmark actually occupies carried almost no scrim at all.
     The top ramp is unchanged — it exists for the nav, which has not moved. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ground) 35%, transparent) 0%,
      transparent 22%,
      transparent 44%,
      color-mix(in srgb, var(--ground) 64%, transparent) 68%,
      color-mix(in srgb, var(--ground) 84%, transparent) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    /* Top padding clears the fixed site-nav (--nav-height), which overlaps
       the hero at every width since the nav is position: fixed with no
       document flow of its own. Bug found in Step 2 review: the location
       line rendered directly under the nav's wordmark link. */
    padding-block: calc(var(--nav-height) + 1.5rem) 2rem;
  }

  .hero__center {
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
    gap: 0.75rem;
  }

  /* ---- The wordmark. Rebuilt in step 10a as a legibility fix, NOT as the
     final brand mark — Amy is still choosing between three candidate
     typefaces and that decision is logged as blocking in ASK-AMY.md. Nothing
     here should be read as a decision about what the mark eventually is.

     What was wrong: `type-display` at up to 92px, white, centred in the dead
     middle of the frame. The vertical centre of a room photograph is where
     the wall is, and a wall is the brightest thing in the picture, so the
     middle of the wordmark vanished into it while the ends stayed readable.

     Three changes, all of them Amy's own stated direction (July 31 review,
     relayed by Sam — this direction is NOT in DESIGN_BRIEF.md today; step 10
     adds it):
       1. Anchored to the bottom of the frame, not floating in the centre.
          The lower third is darker in every crop, and it is now backed by the
          deepened scrim ramp above.
       2. All caps with wide tracking.
       3. Thinner.

     On (3), specifically: this is the **Label role (3.4) scaled up**, not a
     fourth type role and not a weight outside the system. Label is uppercase
     with 0.18em tracking at weight 500; this is the same treatment at 400,
     which is the lighter of the two weights 3.4 permits, with the tracking
     opened further. Going below 400 in the variable file was considered and
     rejected on the merits rather than on the rule: sub-400 strokes on
     light-on-photograph type are exactly what disappears against a busy
     image, which is the defect being fixed. `--hero-mark-weight` is here so
     that is a one-value change if Amy wants it lighter anyway.

     Size is deliberately well below the Display clamp. A wordmark that has to
     survive an arbitrary photograph behind it wants to be small, wide, and
     dense rather than large and open. ---- */
  .hero__mark {
    --hero-mark-weight: 400;
    margin: 0 0 0.35rem;
    font-weight: var(--hero-mark-weight);
    font-size: clamp(1rem, 0.55rem + 2.1vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    /* Letter-spacing adds a trailing space AFTER the final letter, so the
       glyphs sit half a space left of true centre. Half the tracking, not the
       whole of it: measured in-browser at 1280px, `text-indent` shifts a
       centred line by its full value, so 0.26em over-corrected by exactly the
       same 4.6px it was meant to remove. 0.13em brings the glyph run's optical
       centre to within ~2px of the viewport centre (measured at 1280px:
       642.3 against 640; the residue is the final N's side bearing). */
    text-indent: 0.13em;
    text-align: center;
    max-width: 100%;
  }

  .hero__opening-line {
    max-width: 32ch;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: var(--weight-label);
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .hero__opening-line.is-visible {
    opacity: 1;
  }
  .hero__opening-line.is-visible.is-hiding {
    opacity: 0;
    transition-duration: 900ms;
  }

  .hero__bottom {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
  }

  .hero__words {
    display: flex;
    gap: 2rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .hero__scroll-cue {
    width: 1px;
    height: 2.25rem;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    animation: hero-scroll-cue 2.2s ease-in-out infinite;
  }
  @keyframes hero-scroll-cue {
    0%, 100% { transform: scaleY(0.6); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__layer,
    .hero__layer.is-leaving,
    .hero__scroll-cue {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .hero__words {
      gap: 3rem;
    }
  }
</style>
