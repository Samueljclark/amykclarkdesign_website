---
// Home section 4 (DESIGN_BRIEF.md 5.1): "Four entries... Name and one line
// each. Not a card grid with icons." Names render in the Display role
// (3.4's three-role discipline has no separate "large list" size, so this
// reuses Display rather than inventing a fourth).
//
// PRESENTATION: this is variant B ("asymmetry") from the comparison page Sam
// reviewed, adopted 2026-07-26 and lifted from
// `dev-service-list-variants.astro` before that page was deleted. Every row
// sits at its own indent and its own point size within the Display clamp —
// 3.5's "asymmetry over grids... varied scales and vertical offsets," which
// the site otherwise only does in the portfolio strip. No hairlines, no
// alternating wash, nothing uniform to read as a table. Flush and uniform
// below 768px, where asymmetry reads as broken alignment rather than intent.
//
// THE HOVER STAGE is an interpretation call, flagged in BUILD-PLAN.md. The
// brief has no spec for it; the closest precedent is 6.4's portfolio hover.
// Hovering or keyboard-focusing a row shows that service's photograph in the
// right-hand space. Because the rows sit at deliberately varied indents, the
// photo cannot live inline per row — it is one fixed stage in the section's
// second column that swaps which layer is opaque.
//
// Three gates, and all three matter:
//   1. `(hover: hover)` — touch devices get no stage at all, rather than a
//      half-working hover state. The text-only presentation already works
//      there.
//   2. `(min-width: 1200px)` — below that the rows' own indents plus their
//      jumbo names consume the width the stage would need, and the two would
//      collide.
//   3. `(prefers-reduced-motion: no-preference)` on the swap rules only. Under
//      reduce, the stage still renders but is frozen on the first service's
//      photo: a static image, never a cut and never a partial crossfade.
//
// The swap is pure CSS (`:has()` on the section) — no JS, so there is nothing
// to re-init on a soft navigation and nothing that can leak a listener.
// Keyboard parity is `:focus-visible` alongside `:hover`, the same pattern
// variant C used.

import { Picture } from 'astro:assets';
import { photos } from '../data/photos';
import type { Service } from '../data/services';

interface Props {
  services: Service[];
  // Home shows a visible "Services" header on this card (5.1, 2026-07-31
  // review). /services does not: that page already carries a visible <h1>
  // reading "Services" and a second visible "Services" directly beneath it
  // is a stutter, not a signpost. The heading still exists in both cases for
  // heading order and assistive tech — only its visibility differs.
  headingHidden?: boolean;
}

const { services, headingHidden = false } = Astro.props;
---

<section class="section wrap service-list" aria-labelledby="service-list-heading">
  <h2
    id="service-list-heading"
    class:list={[headingHidden ? 'visually-hidden' : 'type-label section-eyebrow']}
  >
    Services
  </h2>

  <ul class="service-list__items">
    {/* Descriptive, non-clickable sections as of 2026-08-19 (post-Meeting-4
        pass, Task 1): the four individual service pages these rows used to
        link to are gone, consolidated into this one overview. `.service-
        list__link` is now a plain wrapping span, not an anchor — no href, no
        navigation, no `.link-underline` (that device signals "this is a
        link," which would no longer be true). The hover-image reveal below
        still responds to `:hover`/`:has()`, which do not require an
        interactive element; keyboard users no longer get a per-row focus
        target here since there is nothing to activate. */}
    {services.map((service) => (
      <li class="service-list__item">
        <span class="service-list__link">
          <span class="service-list__name-row">
            <span class="type-display service-list__name">{service.name}</span>
          </span>
          <p class="service-list__desc">{service.description}</p>
        </span>
      </li>
    ))}
  </ul>

  {/* The stage follows the list in the DOM so a screen reader meets the four
      service links first, and is placed into the right-hand column visually by
      the grid. It is `display: none` outside the gated media query, so on
      touch and at narrow widths these images are not in the accessibility
      tree and are not fetched at all. Alt text is real per rule 10 rather
      than empty-and-aria-hidden: these are real photographs of real work, and
      the site's image search depends on them. */}
  <div class="service-list__stage reveal-frame">
    <div class="reveal service-list__stage-inner">
      {services.map((service) => {
        const photo = photos[service.photo];
        return (
          <div class="service-list__layer">
            <div
              class="service-list__layer-blur"
              style={`background-image:url(${photo.blurDataURL})`}
              aria-hidden="true"
            >
            </div>
            <Picture
              src={photo.image}
              alt={photo.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[480, 768, 1200]}
              sizes="(min-width: 1200px) 37vw, 1px"
              loading="lazy"
              class="service-list__layer-img"
              {...(service.objectPosition
                ? { style: `object-position:${service.objectPosition}` }
                : {})}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ---- Variant B: asymmetry. Values lifted verbatim from the comparison
     page's `.vb__*` rules. ---- */
  .service-list__item + .service-list__item {
    margin-top: 2.5rem;
  }

  /* The row wrapper is what keeps 6.6's underline device honest: it is
     block-level and full-width, so the name inside it shrink-wraps to its own
     text no matter what layout the link ever takes. `.link-underline` on a
     grid or flex item draws across the whole track instead of under the word
     — that was a real, fixed bug, and it is why this wrapper exists. */
  .service-list__name-row {
    display: block;
  }

  .service-list__name {
    display: inline-block;
  }

  .service-list__desc {
    margin-top: 0.75rem;
    max-width: 42ch;
    color: var(--ink-muted);
  }

  /* ---- Size hierarchy removed 2026-07-31 (Kristen Hitch review, 5.3).
     Every service name now renders at ONE size and one weight. The four
     per-row `font-size` clamps that used to live here made Custom Drapery
     nearly twice the size of Soft Furnishings, which tells a reader that one
     service matters more than another — not true, and not the message.

     The staggered INDENTS below stay, and that is the explicit distinction
     the review drew: varied position is 3.5's asymmetry and it is welcome;
     varied scale is a claim about importance. Vary where a name sits, never
     how big it is. Do not reintroduce per-row font sizes here. ---- */
  .service-list__name {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem);
  }

  @media (min-width: 768px) {
    .service-list__item + .service-list__item {
      margin-top: 4.5rem;
    }
    .service-list__item:nth-child(1) {
      margin-left: 0;
    }
    .service-list__item:nth-child(2) {
      margin-left: 26%;
    }
    .service-list__item:nth-child(3) {
      margin-left: 9%;
    }
    .service-list__item:nth-child(4) {
      margin-left: 38%;
    }
  }

  /* ---- The hover stage. Off by default, in every sense: not displayed, so
     not in the accessibility tree and not fetched. ---- */
  .service-list__stage {
    display: none;
    position: relative;
    width: 100%;
    /* Same containment as RevealImage's `.reveal-frame`: the resting
       `scale(1.04)` would otherwise widen the document. See that file. */
    overflow: hidden;
  }

  @media (hover: hover) and (min-width: 1200px) {
    /* Two children, auto-placed: the list takes column 1, the stage column 2.
       The list column is deliberately narrower than the section so the rows'
       own indents resolve against it and leave the right-hand space clear.
       The gap absorbs the little that the widest name overhangs. */
    /* Two children, auto-placed: the list takes column 1, the stage column 2. */
    .service-list {
      display: grid;
      grid-template-columns: 58% 1fr;
      column-gap: 5%;
      align-items: center;
    }

    /* Three children now, not two: the section heading became visible in the
       2026-07-31 review and is therefore a real grid item. It has to span
       both tracks explicitly — auto-placement would otherwise put it in
       column 1 and push the list into column 2 and the hover stage onto a
       second row, which is exactly what happened the first time. While the
       heading was `visually-hidden` (position: absolute) it was out of flow
       and this could not bite. */
    .service-list > h2 {
      grid-column: 1 / -1;
    }

    .service-list__stage {
      display: block;
      aspect-ratio: 4 / 5;
      /* A photograph appearing in space, not a UI element: no card, no
         border, no shadow, no radius (3.2). */
    }

    /* The signature shade reveal (3.7), same two-box arrangement
       RevealImage.astro uses: `.reveal` is global.css and carries the
       clip-path; `.reveal-frame` is the unclipped wrapper motion.js measures
       (a clipped box reports intersectionRatio 0 forever and the reveal never
       fires — see RevealImage.astro's note). `.reveal-frame` has no styles of
       its own outside that component, so the frame's own layout is the
       `.service-list__stage` rules above. Do not put a clip-path on it. The
       stage reveals once on scroll like every other image on the site; the
       layer crossfade below happens inside it. */
    .service-list__stage-inner {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .service-list__layer {
      position: absolute;
      inset: 0;
      opacity: 0;
    }

    /* Resting state: the first service's photo. Something is always on the
       stage, so nothing pops into or out of existence on the first hover. */
    .service-list__layer:first-child {
      opacity: 1;
    }

    .service-list__layer-blur {
      position: absolute;
      inset: -10%;
      background-size: cover;
      background-position: center;
      filter: blur(20px);
    }

    /* Same reason as RevealImage: `<Picture>` emits a `<picture>` wrapper and
       global.css's `img, picture { height: auto }` applies to it, so the
       img's `height: 100%` needs a parent that actually has one before
       `object-fit: cover` means anything. */
    .service-list__layer picture {
      display: block;
      width: 100%;
      height: 100%;
    }

    .service-list__layer-img {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* ---- The swap itself. Motion, therefore gated (6.8, and the brief's rule
     9: every animation has a prefers-reduced-motion off-switch). Under reduce
     none of these rules exist, so the stage holds the first photo statically
     — no cut, no partial crossfade, nothing to interrupt.

     Crossfade duration reuses 6.4's portfolio-hover token, which is the
     closest thing in the brief to a spec for this.

     `:focus-visible` variants removed 2026-08-19 (Task 1, post-Meeting-4
     pass): `.service-list__link` is a plain `<span>` now, not an anchor, so
     it is never a focus target and the selector could not match anything.
     This stage is decorative and mouse-hover-only now, matching the row
     text itself, which is no longer interactive either. ---- */
  @media (hover: hover) and (min-width: 1200px) and (prefers-reduced-motion: no-preference) {
    .service-list__layer {
      transition: opacity var(--hover-image-duration) ease-out;
    }

    /* Any active row clears the resting default first... */
    .service-list:has(.service-list__link:hover) .service-list__layer {
      opacity: 0;
    }

    /* ...then the matching layer comes up. */
    .service-list:has(.service-list__item:nth-child(1) .service-list__link:hover)
      .service-list__layer:nth-child(1) {
      opacity: 1;
    }
    .service-list:has(.service-list__item:nth-child(2) .service-list__link:hover)
      .service-list__layer:nth-child(2) {
      opacity: 1;
    }
    .service-list:has(.service-list__item:nth-child(3) .service-list__link:hover)
      .service-list__layer:nth-child(3) {
      opacity: 1;
    }
    .service-list:has(.service-list__item:nth-child(4) .service-list__link:hover)
      .service-list__layer:nth-child(4) {
      opacity: 1;
    }
  }
</style>
