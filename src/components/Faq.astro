---
// Contact FAQ (DESIGN_BRIEF.md 5.7: "Below the form, the FAQ. Frame every answer
// around the value Amy provides. No price answers.") plus the FAQPage JSON-LD
// 8.2 requires. The structured data lives here rather than waiting for step 7's
// JsonLd.astro because it has to be generated from these exact question and
// answer strings — splitting them across two files guarantees they drift.
// BUILD-PLAN.md's component table already assigns FAQPage to this component.
//
// Reuses Accordion.astro (6.5's animated grid-template-rows expansion), the
// same component the blinds decision categories use. That is deliberate: the
// brief authorises one expansion pattern and this is it.
//
// **The consultation fee amount appears nowhere here, and must not.** 5.7 and
// rule 2: no amount until Amy confirms one, and no claim that the fee credits
// toward the project, because it does not. ASK-AMY.md tracks the amount as an
// open question. The answers say the visit is paid and what it buys, which is
// what the brief actually permits.
//
// `faqs` is a required prop as of Phase 2 (copy-bulk-swap, BUILD-PLAN.md)
// rather than a hardcoded const — the questions and answers now live in
// src/content/pages/contact.md, the one file to edit for this page's copy.
// Still passed as a real prop, not read from the collection here, so this
// component stays reusable and its only job stays "render FAQs + emit
// FAQPage JSON-LD from whatever it's given."

import Accordion from './Accordion.astro';

interface Faq {
  title: string;
  content: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.content,
    },
  })),
};
---

<section class="section wrap faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="type-display faq__heading">Common questions</h2>
  <Accordion items={faqs} />
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<style>
  .faq__heading {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    margin-bottom: 2.5rem;
  }
</style>
