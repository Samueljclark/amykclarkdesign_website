---
// The qualification form (DESIGN_BRIEF.md 5.7). Every field in 5.7's table, in
// 5.7's order, with Budget and "How did you hear about Amy?" required — the
// two the brief singles out, and acceptance criterion "Consultation form
// requires budget and attribution."
//
// Backend: Netlify Forms (BUILD-PLAN.md decision 1). `data-netlify="true"` is
// what Netlify's post-processing looks for when it scans the built HTML;
// `netlify-honeypot` names the decoy field (section 7's honeypot requirement).
// `enctype="multipart/form-data"` is required by Netlify for the file input, not
// optional.
//
// `data-astro-reload` is load-bearing. Astro's ClientRouter intercepts POST
// submissions and replays them through its own fetch-based navigation, which
// never reaches Netlify's form handler — the submission would appear to succeed
// and no entry would ever arrive. This attribute forces a real browser
// navigation for this one form. Do not remove it while ClientRouter is enabled
// in Base.astro.
//
// **Server-side validation (section 7) is NOT satisfied by this component.**
// Netlify Forms accepts whatever is POSTed; `required` here is browser-side
// only. Flagged in BUILD-PLAN.md — closing it properly needs a Netlify
// Function, which is a step 7 decision, not something to fake here.
//
// Option values are the label strings themselves rather than slugs, so a
// notification email reads as a sentence instead of `budget=tier-3`. Nothing
// downstream parses them.
//
// Required/optional marking is inverted from the usual convention on purpose:
// seven of the eleven fields are required, so the four optional ones carry the
// mark. `required` is still on the inputs, so assistive tech announces it
// either way.

// 5.7's exact multi-select list.
const projectTypes = [
  'Drapery',
  'Blinds and shades',
  'Upholstery',
  'Soft furnishings',
  'Whole home',
  'Not sure',
];

// Resolved in BUILD-PLAN.md decision 2, recorded in DESIGN_BRIEF.md 5.7.
// Verbatim from that table — do not adjust these without Sam.
const budgetRanges = [
  'Under $2,500',
  '$2,500 to $7,500',
  '$7,500 to $20,000',
  '$20,000 to $50,000',
  '$50,000+',
  "I'd like Amy's guidance on this",
];

// **Interpretation, not resolved anywhere.** 5.7 requires a Timeline select and
// is silent on its options; no source in this repo lists them. These are
// deliberately plain and non-committal. Flagged in BUILD-PLAN.md for Sam.
const timelines = [
  'As soon as possible',
  'Within one to three months',
  'Within three to six months',
  'Six months or more out',
  'Still planning',
];

// Resolved in BUILD-PLAN.md decision 3, recorded in DESIGN_BRIEF.md 5.7.
// Verbatim from that table.
const referralSources = [
  'Google search',
  'Instagram',
  'Facebook',
  'Referred by a friend or family member',
  'Referred by a designer or builder',
  'Saw her work in a home',
  'Houzz',
  'Other',
];
---

<form
  class="consultation-form"
  name="consultation"
  method="POST"
  action="/contact/thank-you"
  enctype="multipart/form-data"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-astro-reload
  data-consultation-form
>
  {/* **LOAD-BEARING. Do not remove.** Netlify routes an incoming POST to the
      right form by reading a `form-name` value out of the REQUEST BODY, not
      from the form's `name` attribute. Without this hidden input the browser
      posts a body with no `form-name` in it, Netlify cannot match it to a
      registered form, and the submission is dropped with no error anywhere:
      the visitor still lands on the thank-you page and still believes it
      worked.

      Netlify's post-processing normally injects this itself when it detects a
      static form at deploy time, which is why the form looked correct for so
      long. That injection is a build-time step that can silently not happen.
      Declaring it explicitly costs one line and removes the dependency —
      Netlify skips its own injection when the input is already present, so
      there is no risk of a duplicate.

      The value MUST stay identical to the form's `name` attribute above.

      This is a curly-brace JS comment, not an HTML one, so it stays in the
      source for whoever reads this next without shipping to every visitor.
      (An HTML comment here bled through to the rendered page once already —
      see BUILD-PLAN.md. Do not swap this back to <!-- --> .) */}
  <input type="hidden" name="form-name" value="consultation" />

  {/* Honeypot (section 7). Hidden from sight and from the accessibility tree;
      Netlify discards any submission that fills it. Not `display: none` on the
      input alone — some autofill implementations still populate those.
      Named by `netlify-honeypot` on the form tag above; Netlify accepts that
      spelling and `data-netlify-honeypot` equally, and `netlify-honeypot` is
      the one in Netlify's own documentation. */}
  <p class="consultation-form__honeypot" aria-hidden="true">
    <label>
      Do not fill this in
      <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="consultation-form__grid">
    <p class="field consultation-form__field">
      <label class="type-label field__label" for="name">Name</label>
      <input type="text" id="name" name="name" autocomplete="name" required />
    </p>

    <p class="field consultation-form__field">
      <label class="type-label field__label" for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required />
    </p>

    <p class="field consultation-form__field">
      <label class="type-label field__label" for="phone">
        Phone <span class="field__optional">Optional</span>
      </label>
      <input type="tel" id="phone" name="phone" autocomplete="tel" />
    </p>

    <p class="field consultation-form__field">
      <label class="type-label field__label" for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        autocomplete="address-level2"
        aria-describedby="location-hint"
        required
      />
      <!-- Service-area note, added 2026-07-31 (DESIGN_BRIEF 5.7). Geography
           came out of the hero in the same review and has to be somewhere a
           reader is actually deciding whether Amy covers them — which is
           here, mid-form, next to the field asking where they live.
           Third person as of the 2026-08-18 voice rewrite
           (SITE-COPY-THIRD-PERSON.md), implemented 2026-08-19. -->
      <span id="location-hint" class="field__hint">
        Your city or neighborhood. Amy works throughout Cincinnati and Northern Kentucky.
      </span>
    </p>
  </div>

  <p class="field consultation-form__field consultation-form__field--wide">
    <label class="type-label field__label" for="room">Tell Amy about your room</label>
    <textarea id="room" name="room" rows="5" aria-describedby="room-hint" required></textarea>
    <span id="room-hint" class="field__hint">
      Which room, which windows, and what is not working about it now.
    </span>
  </p>

  <p class="field consultation-form__field consultation-form__field--wide">
    <label class="type-label field__label" for="about-you">
      Tell Amy about you <span class="field__optional">Optional</span>
    </label>
    <textarea id="about-you" name="about-you" rows="4" aria-describedby="about-you-hint"></textarea>
    <span id="about-you-hint" class="field__hint">
      How you live in the room, who else uses it, and what you already know you like.
    </span>
  </p>

  <fieldset class="field consultation-form__fieldset" data-checkbox-group>
    <legend class="type-label field__label">Project type</legend>
    <ul class="consultation-form__checks">
      {projectTypes.map((type, i) => (
        <li>
          <label class="consultation-form__check">
            <input
              type="checkbox"
              name="project-type"
              value={type}
              data-checkbox-group-input={i === 0 ? 'anchor' : undefined}
            />
            <span>{type}</span>
          </label>
        </li>
      ))}
    </ul>
    <span class="field__hint">Choose as many as apply.</span>
  </fieldset>

  <div class="consultation-form__grid">
    <p class="field consultation-form__field">
      <label class="type-label field__label" for="budget">Budget</label>
      <select id="budget" name="budget" required>
        <option value="">Select one</option>
        {budgetRanges.map((range) => <option value={range}>{range}</option>)}
      </select>
    </p>

    <p class="field consultation-form__field">
      <label class="type-label field__label" for="timeline">
        Timeline <span class="field__optional">Optional</span>
      </label>
      <select id="timeline" name="timeline">
        <option value="">Select one</option>
        {timelines.map((timeline) => <option value={timeline}>{timeline}</option>)}
      </select>
    </p>
  </div>

  {/* ---- Photos. Reported 2026-08-29: two photos were submitted, one arrived.

       Not a markup bug — a Netlify Forms limitation, confirmed in their own
       docs (docs.netlify.com/manage/forms/setup/): "Only one file upload per
       field is supported. For multiple file uploads, use multiple fields."
       The browser posts every selected file under the one `photos` name and
       Netlify keeps exactly one of them. `multiple` on a single input can
       never deliver more than one file to Netlify, however it is written.

       So there are now four REAL, separately-named file inputs. They must
       exist in the built HTML rather than be created at runtime, because
       Netlify detects a form's fields by parsing the deployed markup at build
       time — inputs injected by JS would never be registered, and their files
       would be dropped exactly the way the second photo was.

       The single visible picker is kept: the script below moves each selected
       file into its own slot, so choosing several photos at once still works
       the way it looks like it should. Without JS the visible input still
       submits one file, which is today's behaviour and no worse.

       Two other Netlify limits from the same page, both of which bite here:
       the whole POST is capped at 8 MB and uploads time out after 30 seconds.
       Modern phone photos run 2-5 MB each, so two of them can exceed the cap
       and fail the ENTIRE submission — name, email, budget and all, not just
       the photos. That is a worse failure than the one being fixed, so the
       script also holds the total under the cap rather than letting a big
       selection silently sink the whole inquiry. ---- */}
  <p class="field consultation-form__field consultation-form__field--wide">
    <label class="type-label field__label" for="photos">
      Photos <span class="field__optional">Optional</span>
    </label>
    <input
      type="file"
      id="photos"
      name="photos"
      multiple
      accept="image/*"
      aria-describedby="photos-hint photos-status"
      data-photo-picker
    />

    {/* The real upload fields. `photo-1` carries the first photo once the
        script takes over (at which point the visible picker above loses its
        `name` so nothing is posted twice). Hidden from view and from the tab
        order — the visible picker is the only control anyone interacts
        with — but still submitted, which is what matters. */}
    <span class="consultation-form__photo-slots" data-photo-slots>
      <input type="file" name="photo-1" tabindex="-1" aria-hidden="true" data-photo-slot />
      <input type="file" name="photo-2" tabindex="-1" aria-hidden="true" data-photo-slot />
      <input type="file" name="photo-3" tabindex="-1" aria-hidden="true" data-photo-slot />
      <input type="file" name="photo-4" tabindex="-1" aria-hidden="true" data-photo-slot />
    </span>

    <span id="photos-hint" class="field__hint">
      Photographs of the room help more than anything else you can send.
    </span>
    {/* DRAFT COPY - NEEDS REWRITE
        Live region, written by the script: confirms how many photos are
        attached, and says so plainly when some were left out because of the
        count or the size cap. Empty until someone chooses a file. */}
    <span
      id="photos-status"
      class="field__hint consultation-form__photo-status"
      role="status"
      aria-live="polite"
      data-photo-status
    ></span>
  </p>

  <!-- Added 2026-08-05. Amy asks this by hand on every discovery call: what
       else in the room has to be worked around. It is the last gap between
       what the form captures and what she actually needs before a visit.
       Optional on purpose — it is a prompt, not a hurdle, and someone who does
       not know the answer yet should not be blocked by it. Sits directly under
       the photo upload because the honest answer to it is usually another
       photograph. -->
  <p class="field consultation-form__field consultation-form__field--wide">
    <label class="type-label field__label" for="existing-colors">
      What else is in the room <span class="field__optional">Optional</span>
    </label>
    <textarea
      id="existing-colors"
      name="existing-colors"
      rows="3"
      aria-describedby="existing-colors-hint"></textarea>
    <span id="existing-colors-hint" class="field__hint">
      The sofa, the flooring, the wall color, anything staying in the room that the
      fabric has to live with. Photographs of these help too.
    </span>
  </p>

  <p class="field consultation-form__field consultation-form__field--wide">
    <label class="type-label field__label" for="referral">How did you hear about Amy?</label>
    <select id="referral" name="referral" required>
      <option value="">Select one</option>
      {referralSources.map((source) => <option value={source}>{source}</option>)}
    </select>
  </p>

  <div class="consultation-form__submit">
    {/* CTA rule, 2026-08-19 (post-Meeting-4 pass, Task 5): "form submit
        buttons become 'Send inquiry'," applied verbatim regardless of the
        prior wording. */}
    <button type="submit" class="btn btn-solid">Send inquiry</button>
  </div>
</form>

<script>
  // Native `required` cannot express "at least one of this checkbox group,"
  // and 5.7 marks Project type required. This puts the constraint on the
  // group's first input via setCustomValidity, so the browser's own validation
  // bubble and focus handling do the work — no custom error UI, no submit
  // handler that could swallow the submission before it reaches Netlify.
  function initCheckboxGroups() {
    document.querySelectorAll('[data-checkbox-group]').forEach((group) => {
      const boxes = Array.from(group.querySelectorAll('input[type="checkbox"]'));
      const anchor = group.querySelector('[data-checkbox-group-input="anchor"]');
      if (!anchor || !boxes.length) return;

      const sync = () => {
        const anyChecked = boxes.some((box) => box.checked);
        anchor.setCustomValidity(anyChecked ? '' : 'Choose at least one project type.');
      };

      boxes.forEach((box) => box.addEventListener('change', sync));
      sync();
    });
  }

  /* ---- Photos: one picked file per Netlify field. See the long note above
     the markup for why this is necessary (Netlify stores ONE file per field,
     so `multiple` on a single input can only ever deliver one).

     This moves each selected file into its own real, statically-declared
     input, and takes the `name` off the visible picker so the same file is
     never posted twice under two different fields.

     It stays inside the 8 MB request cap on purpose. Going over it does not
     drop the photos — it fails the whole submission, losing the name, email
     and budget too, so silently accepting 12 MB of phone photos would trade
     the reported bug for a much worse one. Files that do not fit are left off
     and the status line says so, rather than the form appearing to accept
     them and then failing at submit. ---- */
  const MAX_PHOTOS = 4;
  // 7 MB, not 8: the rest of the form (and multipart overhead) shares the cap.
  const MAX_TOTAL_BYTES = 7 * 1024 * 1024;

  function initPhotoUpload() {
    const picker = document.querySelector('[data-photo-picker]');
    if (!picker || picker.dataset.photoBound === 'true') return;

    // Without DataTransfer there is no way to write to a file input, so leave
    // the native single-file fallback exactly as it is rather than breaking it.
    if (typeof DataTransfer === 'undefined') return;

    const slots = Array.from(document.querySelectorAll('[data-photo-slot]'));
    const status = document.querySelector('[data-photo-status]');
    if (!slots.length) return;

    picker.dataset.photoBound = 'true';
    // From here the slots are the fields that actually carry the files, so the
    // picker must stop being a submitted field of its own.
    picker.removeAttribute('name');

    const fileListOf = (files) => {
      const dt = new DataTransfer();
      files.forEach((file) => dt.items.add(file));
      return dt.files;
    };

    const describe = (kept, overCount, overSize) => {
      if (!kept) return '';
      const noun = kept === 1 ? 'photo' : 'photos';
      let line = `${kept} ${noun} attached.`;
      if (overCount) line += ` Only the first ${MAX_PHOTOS} can be sent through this form.`;
      if (overSize) {
        line +=
          ' The rest were too large to send together. Email them to Amy and she will add them to your inquiry.';
      }
      return line;
    };

    picker.addEventListener('change', () => {
      const picked = Array.from(picker.files || []);
      slots.forEach((slot) => {
        slot.files = fileListOf([]);
      });

      if (!picked.length) {
        if (status) status.textContent = '';
        return;
      }

      const withinCount = picked.slice(0, MAX_PHOTOS);
      const kept = [];
      let total = 0;
      let overSize = false;

      for (const file of withinCount) {
        if (total + file.size > MAX_TOTAL_BYTES) {
          overSize = true;
          continue;
        }
        total += file.size;
        kept.push(file);
      }

      kept.forEach((file, i) => {
        if (slots[i]) slots[i].files = fileListOf([file]);
      });

      if (status) {
        status.textContent = describe(kept.length, picked.length > MAX_PHOTOS, overSize);
      }
    });
  }

  // Same two-call pattern as motion.js: run now for the true first load, and
  // again after each ClientRouter swap, since <main> is replaced.
  initCheckboxGroups();
  initPhotoUpload();
  document.addEventListener('astro:after-swap', () => {
    initCheckboxGroups();
    initPhotoUpload();
  });
</script>

<style>
  /* Hairlines and 2px radius only, no cards, no shadow (3.2). Control base
     styles live in global.css so every form on the site matches. */
  .consultation-form {
    max-width: 44rem;
  }

  /* The four real upload fields. Hidden rather than removed — a
     `display: none` file input still posts its file, which is the whole
     point, and Netlify still sees them when it parses the built HTML. */
  .consultation-form__photo-slots {
    display: none;
  }

  /* Only takes up space once the script writes something into it, so an
     untouched form has no stray gap under the photo field. */
  .consultation-form__photo-status:empty {
    display: none;
  }

  .consultation-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .consultation-form__field,
  .consultation-form__fieldset {
    margin-top: 2rem;
  }

  .field__label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .field__optional {
    /* Same Label role, just the muted weight of a caption (3.3). */
    color: var(--ink-muted);
    margin-left: 0.5rem;
  }

  .field__hint {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .consultation-form__grid {
    display: grid;
    gap: 0;
  }

  @media (min-width: 640px) {
    .consultation-form__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.5rem;
    }
  }

  .consultation-form__fieldset {
    border: none;
    padding: 0;
  }
  .consultation-form__fieldset legend {
    padding: 0;
  }

  .consultation-form__checks {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .consultation-form__checks {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .consultation-form__check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
  }
  /* global.css's `.field input` rule (full width, hairline border, 0.85rem
     padding) is written for text inputs and the fieldset carries `.field` too,
     so a checkbox inherits all of it and renders as a large empty box. Reset
     the four properties that do not belong on a checkbox rather than narrowing
     the global rule, which four reviewed pages already depend on. */
  .consultation-form__check input[type='checkbox'] {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    padding: 0;
    border: none;
    background: none;
    accent-color: var(--ink);
  }

  .consultation-form__field input[type='file'] {
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
  }

  .consultation-form__submit {
    margin-top: 3rem;
  }
</style>
