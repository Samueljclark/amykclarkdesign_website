---
// DESIGN_BRIEF.md 5.1: "Footer. Navigation, location pages, Instagram and
// Facebook links, contact, service area line." Business facts come from
// src/data/business.ts, confirmed by Sam 2026-07-24. Email is still a
// placeholder pending confirmation.
//
// The "Service Areas" column (links to /cincinnati and /northern-kentucky)
// was removed 2026-07-29 per direct session instruction. Those two pages
// still exist and remain in the sitemap; they are just no longer linked
// from anywhere in the site chrome. src/data/nav.ts's `locationPages` is
// left in place in case the link needs to come back.

import { business } from '../data/business';
import { navItems } from '../data/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer bg-ground">
  <div class="wrap section site-footer__grid">
    <div>
      <p class="type-label site-footer__mark">Amy K Clark Design</p>
      <p class="site-footer__area">Cincinnati/NKY Based</p>
      <p class="site-footer__area site-footer__area--secondary">Serving all areas</p>
    </div>

    <nav aria-label="Footer">
      <p class="type-label site-footer__heading">Site</p>
      <ul class="site-footer__list">
        {navItems.map((item) => (
          <li><a href={item.href} class="link-underline">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="type-label site-footer__heading">Contact</p>
      <ul class="site-footer__list">
        <li>
          <a href={business.phoneHref} class="link-underline">{business.phone}</a>
        </li>
        <li>
          <!-- CONFIRM WITH SAM: real contact email -->
          <a href={`mailto:${business.email}`} class="link-underline">{business.email}</a>
        </li>
        <li>
          <a href={business.instagram} class="link-underline" rel="noopener">Instagram</a>
        </li>
        <li>
          <a href={business.facebook} class="link-underline" rel="noopener">Facebook</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__bottom">
    <p class="type-label">&copy; {year} Amy K Clark Design</p>
  </div>
</footer>

<style>
  /* Muted-on-dark pattern: there is no defined "muted paper" token, so
     secondary text on --ground uses opacity on the existing --paper token
     rather than introducing a new color (3.3's "no values not in the
     brief" read literally). Applies to the area line, column headings,
     and the copyright line below. */

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .site-footer__mark {
    margin-bottom: 1rem;
  }
  .site-footer__area {
    max-width: 32ch;
    opacity: 0.7;
  }
  .site-footer__area--secondary {
    margin-top: 0.25rem;
    opacity: 0.5;
  }
  .site-footer__heading {
    margin-bottom: 1rem;
    opacity: 0.6;
  }
  .site-footer__list {
    display: grid;
    gap: 0.65rem;
  }

  /* Persistent affordance, same device as global.css's `p .link-underline::before`
     (6.6's indigo scaleX draw is a hover-only effect and reads as unclickable
     text at rest — see that file for the full rationale). Footer links get the
     identical always-on 1px hairline so "these are links" doesn't depend on
     hovering; the 2px --paper ::after (global.css's .bg-ground override) still
     draws over it on hover/focus, so 6.6's device itself is untouched. */
  .site-footer .link-underline::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .site-footer__bottom {
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 15%, var(--ground));
  }
  .site-footer__bottom p {
    opacity: 0.5;
  }
</style>
