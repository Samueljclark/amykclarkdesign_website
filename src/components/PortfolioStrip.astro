---
// Home section 2 (DESIGN_BRIEF.md 5.1): "Four to six projects, shade-reveal
// on scroll. Project name in Label style beneath each. One link to the full
// portfolio." No teaser copy on these cards — that rule is stated explicitly
// for the /portfolio index (5.2) and applies here too, since a strip card is
// even smaller than an index card.
//
// **The asymmetric offsets are gone as of 2026-08-01 (step 10f).** Each card
// used to carry an `nth-child` `margin-top` of 4rem or 2rem per 3.5's
// "varied vertical offsets"; with two real projects that read as scattered
// rather than composed. The grid, the card, and the caption now all come from
// `.portfolio-grid` in global.css, shared with the /portfolio index so the
// two pages cannot drift. Full reasoning is in that file's comment.
//
// **Two placeholder cards render after the real ones and must be deleted
// before launch** — `placeholderProjects` in src/data/projects.ts,
// LAUNCH_CHECKLIST.md §1. They are inert tinted blocks, not links and not
// photographs, and they have no detail page because they are not `Project`
// records.

import RevealImage from './RevealImage.astro';
import type { Project } from '../data/projects';
import { placeholderProjects } from '../data/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="section wrap portfolio-strip scroll-ease-target" aria-labelledby="portfolio-strip-heading">
  {/* Visible as of the 2026-07-31 review (5.1) — this was a
      `visually-hidden` heading, which left sighted readers scrolling into an
      unlabelled grid of photographs. */}
  <h2 id="portfolio-strip-heading" class="type-label section-eyebrow">Portfolio</h2>

  <ul class="portfolio-grid portfolio-strip__list">
    {projects.map((project) => (
      <li>
        <a href={`/portfolio/${project.slug}`} class="portfolio-grid__link portfolio-strip__link">
          <RevealImage
            src={project.image}
            alt={project.alt}
            blurDataURL={project.blurDataURL}
            aspectRatio="4/5"
            sizes="(min-width: 700px) 32vw, 90vw"
            class="portfolio-strip__image"
          />
          <span class="type-label portfolio-grid__name portfolio-strip__name">{project.name}</span>
        </a>
      </li>
    ))}

    {/* ===================================================================
        PLACEHOLDER CARDS — DELETE BEFORE LAUNCH (step 10f, 2026-08-01).
        Layout review only: they exist so the four-card, two-row grid can be
        judged before real project three and four arrive. Not links, not
        photographs, no detail pages, not in the sitemap. Delete this block
        and the `placeholderProjects` import above together with the array in
        src/data/projects.ts. Tracked in LAUNCH_CHECKLIST.md §1.
        =================================================================== */}
    {placeholderProjects.map((placeholder) => (
      <li>
        <div class="placeholder-slot portfolio-grid__placeholder">
          <span class="type-label">Placeholder — no image</span>
        </div>
        <span class="type-label portfolio-grid__name">{placeholder.name}</span>
      </li>
    ))}
  </ul>

  <p class="portfolio-strip__cta">
    <a href="/portfolio" class="type-label link-underline">View Full Portfolio</a>
  </p>
</section>

<style>
  /* Grid, card, and caption all come from `.portfolio-grid` (global.css),
     shared with the /portfolio index. The old `auto-fit` track sizing and the
     `nth-child` vertical offsets both lived here and are both gone — see that
     file for why, including the `auto-fit` single-item trap the track cap
     used to work around, which no longer applies now the column count is
     explicit. Only the hover treatment (6.4) is strip-specific. */
  .portfolio-strip__name {
    opacity: 0.6;
    transform: translateY(0);
    transition:
      opacity var(--hover-image-duration) ease-out,
      transform var(--hover-image-duration) ease-out;
  }

  /* 6.4 portfolio hover: image scale 1.0 -> 1.03 / 700ms ease-out, caption
     rises 8px, opacity 0.6 -> 1. Nothing else. */
  .portfolio-strip__link:hover .portfolio-strip__image :global(.reveal-image__img),
  .portfolio-strip__link:focus-visible .portfolio-strip__image :global(.reveal-image__img) {
    transform: scale(1.03);
  }
  .portfolio-strip__link :global(.reveal-image__img) {
    transition: transform var(--hover-image-duration) ease-out;
  }
  .portfolio-strip__link:hover .portfolio-strip__name,
  .portfolio-strip__link:focus-visible .portfolio-strip__name {
    opacity: 1;
    transform: translateY(-8px);
  }

  .portfolio-strip__cta {
    margin-top: 3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-strip__link:hover .portfolio-strip__image :global(.reveal-image__img) {
      transform: none;
    }
  }
</style>
