---
// Project detail page image flow (DESIGN_BRIEF.md 5.2). Lead is full-bleed
// (3.5); the supporting frames below it are a COLLAGE, not a scroll.
//
// Changed 2026-07-31 (Kristen Hitch review). 5.2 previously asked for "three
// to eight supporting images" and this component rendered them as a grid of
// tiles up to 32rem wide — in practice a long vertical stack that asked the
// reader to scroll a gallery before reaching the copy. The brief now says "a
// tight, small collage — not a long photo scroll," and this is that: smaller
// tiles, tighter gutters, capped overall width, and mixed tile heights so the
// set reads as one arranged group rather than a queue.
//
// Tile count is a data decision, not a layout one — see projects.ts, where
// Ivory House was cut from eight frames to four.

import RevealImage from './RevealImage.astro';
import type { ProjectImage } from '../data/projects';

interface Props {
  lead: ProjectImage;
  supporting: ProjectImage[];
  leadTransitionName?: string;
}

const { lead, supporting, leadTransitionName } = Astro.props;
---

<RevealImage
  src={lead.image}
  alt={lead.alt}
  blurDataURL={lead.blurDataURL}
  aspectRatio="16/9"
  sizes="100vw"
  loading="eager"
  fetchpriority="high"
  transitionName={leadTransitionName}
/>

{supporting.length > 0 && (
  <ul class="wrap project-gallery__list">
    {supporting.map((item, i) => (
      <li class="project-gallery__item">
        <RevealImage
          src={item.image}
          alt={item.alt}
          blurDataURL={item.blurDataURL}
          {/* Alternating portrait/landscape tiles are what make this read as
              a collage rather than a uniform contact sheet. */}
          aspectRatio={i % 2 === 0 ? '4/5' : '1/1'}
          sizes="(min-width: 900px) 22vw, (min-width: 600px) 44vw, 90vw"
        />
      </li>
    ))}
  </ul>
)}

<style>
  /* The collage. Two columns on mobile so even the smallest screen sees a
     group rather than a column, four at desktop. `minmax(0, 1fr)` tracks
     rather than the old `auto-fit` + 32rem max: the tiles are deliberately
     small and the container is capped, so the single-item blow-up that
     `auto-fit` + `1fr` used to cause (a 1249x1561 image at 1345px, taller
     than the viewport) cannot happen here — one item in a 2-column grid
     takes one 2-column-width track, not the whole row. */
  .project-gallery__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
    /* Capped and centred: a collage that runs the full width of a 2560px
       display is a scroll again, just horizontal. */
    max-width: 60rem;
  }

  /* Alternating tiles used to nudge down 1.75rem here — 3.5's asymmetry, at
     collage scale. Flattened 2026-08-19 (post-Meeting-4 pass, Task 8):
     Kristen's alignment critique was general ("no two-up-one-down patterns
     anywhere"), not scoped to the sections she happened to review, and this
     component is still real code even while the portfolio route it serves is
     flag-disabled (src/config/flags.ts). Every tile now shares one baseline. */

  @media (min-width: 900px) {
    .project-gallery__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
