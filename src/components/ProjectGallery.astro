---
// Project detail page image flow (DESIGN_BRIEF.md 5.2): a lead image, then
// three to eight supporting images. Lead is full-bleed (3.5); supporting
// images sit in a quiet grid — the brief only asks for asymmetry on index
// listings (Home strip, Portfolio index), not the detail page's own gallery.

import RevealImage from './RevealImage.astro';
import type { ProjectImage } from '../data/projects';

interface Props {
  lead: ProjectImage;
  supporting: ProjectImage[];
  leadTransitionName?: string;
}

const { lead, supporting, leadTransitionName } = Astro.props;
---

<RevealImage
  src={lead.image}
  alt={lead.alt}
  blurDataURL={lead.blurDataURL}
  aspectRatio="16/9"
  sizes="100vw"
  loading="eager"
  fetchpriority="high"
  transitionName={leadTransitionName}
/>

{supporting.length > 0 && (
  <ul class="wrap project-gallery__list">
    {supporting.map((item) => (
      <li class="project-gallery__item">
        <RevealImage
          src={item.image}
          alt={item.alt}
          blurDataURL={item.blurDataURL}
          aspectRatio="4/5"
          sizes="(min-width: 768px) 40vw, 90vw"
        />
      </li>
    ))}
  </ul>
)}

<style>
  .project-gallery__list {
    display: grid;
    gap: 3rem 1.5rem;
    /* The track max is 32rem, not `1fr`, and that matters. With `auto-fit`,
       a `1fr` max is a trap on a single item: auto-fit collapses the empty
       tracks to 0 and the one surviving track absorbs the entire row. At
       1345px that rendered a 1249x1561 image — taller than the viewport, and
       on a short laptop screen roughly two screens tall. Capping the max
       lets one item render at a sane size while three or more still fill the
       row exactly as before. The bug only appears while a collection holds a
       single item, which is the state the portfolio and this gallery are
       actually in today. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 32rem));
    margin-top: 3rem;
  }
</style>
