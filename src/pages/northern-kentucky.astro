---
// Location page (DESIGN_BRIEF.md section 4). Same standing as /cincinnati:
// exists for search, lives in the footer rather than the main nav, and does
// not conflict with the no-geography project-naming rule — section 4 says so
// explicitly. Nothing here names a project, a client, or an address.
//
// Keyword target (8.3): "custom drapery Northern Kentucky" — title, H1, first
// paragraph, meta description, once each.
//
// Cut down 2026-07-29 (session task): the Kentucky-side neighborhood list
// (Fort Mitchell, Fort Thomas, Villa Hills, Crestview Hills, Union, Edgewood),
// the invented example rooms, and the Fort Wright/driving-distance copy are
// all removed. None of it was ever confirmed with Amy — flagged in
// ASK-AMY.md — and Fort Wright is a city-level "based in" claim, which the
// site no longer states in any visible copy (business.ts's `baseCity` still
// carries it for schema/areaServed purposes only). The only acceptable
// location wording on this page now is "Cincinnati and Northern Kentucky."
// Page is intentionally thin — h1, one intro paragraph, one paragraph on the
// work, links to services and process. First person as of the 2026-08-17
// voice rewrite (SITE-COPY-REWRITE.md), implemented 2026-08-18.
//
// Vendor naming: rule 8's "the lines I represent." No pricing (rule 1).
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/northern-kentucky.md
// is now the one file to edit for this page's title, meta, lead, and body
// prose (including its two inline links).
//
// Image: real Ivory House shoot photography (Phase 3, 2026-07-29), replacing
// the substitute crop this page ran on since step 7. See IMAGE-MANIFEST.md.

import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import RevealImage from '../components/RevealImage.astro';
import { photos } from '../data/photos';
import { getEntry, render } from 'astro:content';

const lead = photos['ivory-house-archway'];
const entry = await getEntry('pages', 'northern-kentucky');
const { Content } = await render(entry);
const { seoTitle, description, eyebrow, title, lead: leadParagraphs } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Northern Kentucky', href: '/northern-kentucky' },
  ]}
>
  <section class="section wrap text-page__intro">
    <p class="type-label text-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display text-page__heading">{title}</h1>
    {leadParagraphs.map((paragraph) => <p class="text-page__lead">{paragraph}</p>)}
  </section>

  <RevealImage
    src={lead.image}
    alt={lead.alt}
    blurDataURL={lead.blurDataURL}
    aspectRatio="16/9"
    sizes="100vw"
  />

  <section class="section wrap">
    <div class="prose">
      <Content />
    </div>
  </section>

  <ContactBand />
</Base>
