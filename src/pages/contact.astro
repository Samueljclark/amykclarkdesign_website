---
// Contact (DESIGN_BRIEF.md 5.7). "This is a qualification form, not a booking
// link. Its job is to filter." Three parts, in the brief's order: the paragraph
// explaining what the consultation is, the form, then the FAQ.
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/contact.md is now
// the one file to edit for this page's title, meta, the three lead
// paragraphs, and all seven FAQ question/answer pairs. The intro paragraphs
// are the most rule-bound copy on the site (5.7: say it is a paid in-home
// visit; do NOT say the fee credits toward the project — rule 2, it does
// not; do not apologise for the fee; do not state the amount until Amy
// confirms one, open in ASK-AMY.md) — that file's own frontmatter comment
// repeats the rule so it survives edits.
//
// **Two deliberate omissions, both interpretations rather than oversights:**
// - No lead image. Every other text-led page opens with one, but 5.7 does not
//   ask for one and the site has three usable photographs total, each already
//   doing three or four jobs. A fifth reuse would add nothing here. Revisit once
//   Kelsee's shoot lands (IMAGE-MANIFEST.md).
// - No phone number or email on the page. The footer already carries contact
//   details (5.1). Putting them beside the form would give a reader a way around
//   the filter the brief says this page exists to be.

import Base from '../layouts/Base.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import Faq from '../components/Faq.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'contact');
const { seoTitle, description, eyebrow, title, lead, faqs } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact' },
  ]}
>
  <section class="section wrap text-page__intro">
    <p class="type-label text-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display text-page__heading">{title}</h1>
    {lead.map((paragraph, i) => (
      <p class={i === 0 ? 'text-page__lead' : 'contact__lead-continued'}>{paragraph}</p>
    ))}
  </section>

  <section class="section wrap contact__form-section" aria-labelledby="form-heading">
    {/* CTA rule, 2026-08-19 (post-Meeting-4 pass, Task 5): impersonal
        imperatives, no person reference at all. Amy raised discomfort with
        CTAs addressing her by name directly — the section heading is the
        "section CTA" framing the form and changes; ConsultationForm.astro's
        own textarea field label below it keeps "Tell Amy about your room"
        unchanged, since a field label describing what to type is not a CTA
        (Task 5's own approved-replacements list is scoped to buttons, link
        CTAs, form submits, and section CTAs, not functional field labels). */}
    <h2 id="form-heading" class="type-display contact__form-heading">Start a project</h2>
    <ConsultationForm />
  </section>

  <Faq faqs={faqs ?? []} />
</Base>

<style>
  .contact__lead-continued {
    max-width: var(--measure);
    margin-top: 1rem;
  }

  /* The form section follows the intro immediately, so it drops the leading
     section pad rather than stacking 160px on top of 160px. */
  .contact__form-section {
    padding-block-start: 0;
  }

  .contact__form-heading {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    margin-bottom: 2.5rem;
  }
</style>
