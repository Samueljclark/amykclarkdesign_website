---
// DISABLED FOR V1 LAUNCH (2026-08-19, post-Meeting-4 pass, Task 2). Amy has
// one photographed house on file; Amy and Kristen agreed a thin portfolio
// reads worse than none. Moved here from src/pages/portfolio/ — Astro
// excludes any `_`-prefixed directory under src/pages/ from routing, which
// is what actually kills the route; FLAGS.portfolioEnabled (src/config/
// flags.ts) is what every OTHER consumer (nav, footer, Home's teaser
// section, 404, the thank-you page) checks. To re-enable: flip that flag to
// `true` and move this whole directory back to src/pages/portfolio/. Do not
// re-enable without Sam's explicit request.
//
// Everything below is unchanged from the live page.
//
// Portfolio index (DESIGN_BRIEF.md 5.2): project name only, no teaser copy.
// Still not shared as a component with Home's PortfolioStrip — this page has
// a real, visible <h1> and no "View Full Portfolio" CTA (it's already the
// full list).
//
// **Uniform grid as of 2026-08-01 (step 10f), not 5.2's "asymmetric image
// list".** The `nth-child` vertical offsets are gone and the grid, card, and
// caption come from `.portfolio-grid` in global.css — the same rules Home's
// strip uses, so "the two pages match" is guaranteed by one definition rather
// than by two style blocks that agree today. Reasoning and the brief
// deviation are recorded in that file's comment.
//
// **Two placeholder cards render after the real ones and must be deleted
// before launch** (LAUNCH_CHECKLIST.md §1). They carry no detail page and no
// sitemap entry because they are not `Project` records — see projects.ts.

import Base from '../../../layouts/Base.astro';
import RevealImage from '../../../components/RevealImage.astro';
import { projects, placeholderProjects } from '../../../data/projects';
---

<Base
  title="Portfolio | Amy K Clark Design"
  description="Custom drapery, blinds and shades, and upholstery projects by Amy K Clark Design, Cincinnati and Northern Kentucky."
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Portfolio', href: '/portfolio' },
  ]}
>
  <section class="section wrap">
    <h1 class="type-display portfolio-index__heading">Portfolio</h1>

    <ul class="portfolio-grid">
      {projects.map((project) => (
        <li>
          <a href={`/portfolio/${project.slug}`} class="portfolio-grid__link">
            <RevealImage
              src={project.image}
              alt={project.alt}
              blurDataURL={project.blurDataURL}
              aspectRatio="4/5"
              sizes="(min-width: 700px) 32vw, 90vw"
              transitionName={`project-photo-${project.slug}`}
            />
            <span class="type-label portfolio-grid__name">{project.name}</span>
          </a>
        </li>
      ))}

      {/* =================================================================
          PLACEHOLDER CARDS — DELETE BEFORE LAUNCH (step 10f, 2026-08-01).
          Same two entries the Home strip renders, so the two pages match in
          content as well as in layout. Delete this block and the
          `placeholderProjects` import together with the array in
          src/data/projects.ts. Tracked in LAUNCH_CHECKLIST.md §1.
          ================================================================= */}
      {placeholderProjects.map((placeholder) => (
        <li>
          <div class="placeholder-slot portfolio-grid__placeholder">
            <span class="type-label">Placeholder. No image.</span>
          </div>
          <span class="type-label portfolio-grid__name">{placeholder.name}</span>
        </li>
      ))}
    </ul>

    {/* The /signature-pieces link that used to sit here is gone with the page
        itself (step 9a, 2026-07-31 review). Nothing replaces it: the pillow
        photography (src/data/photos.ts) is currently unused, its own former
        home (/services/soft-furnishings) having been removed and folded into
        the Services overview 2026-08-19 (post-Meeting-4 pass, Task 1). */}
  </section>
</Base>

<style>
  .portfolio-index__heading {
    max-width: 18ch;
    margin-bottom: 3rem;
  }

  /* The grid, the card, and the caption all live in `.portfolio-grid`
     (global.css), shared with Home's strip. Nothing index-specific remains
     beyond the heading above. */
</style>
