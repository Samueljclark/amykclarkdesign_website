---
// Home (DESIGN_BRIEF.md 5.1). Six sections in the order the brief specifies:
// hero, portfolio, differentiator, services, testimonials, contact. The two
// signature moves (full-screen hero gallery, shade reveal) carry the whole
// design thesis per BUILD-PLAN.md step 2 — everything else here stays quiet.
//
// SEO (8.1/8.3): the hero deliberately carries no headline text ("no
// headline block, no descriptor paragraph" - 5.1), so the keyword-bearing
// <h1> is a visually-hidden element up front instead of the on-screen
// wordmark. The primary keyword ("custom window treatments Cincinnati")
// appears in the title, this H1, and the differentiator paragraph below
// (the first real body copy on the page), plus the meta description.

import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import HeroGallery from '../components/HeroGallery.astro';
import PortfolioStrip from '../components/PortfolioStrip.astro';
import ServiceList from '../components/ServiceList.astro';
import Quote from '../components/Quote.astro';
import QuoteRotator from '../components/QuoteRotator.astro';
import { projects } from '../data/projects';
import { services } from '../data/services';
import { photos } from '../data/photos';

// Second testimonial slot (5.1, amended). Every one of these is a real
// fragment from a real review — nothing here is written for the site.
// **Heather L. and Jenny H. are named as candidates in BUILD-PLAN decision 4
// but their review text does not exist anywhere in this repo**, so they are
// deliberately absent rather than paraphrased. Adding either is one entry
// here once Sam pastes the actual wording in. See ASK-AMY.md.
const rotatingQuotes = [
  {
    quote: 'She even matches complicated designs on the seams.',
    attribution: 'Kelly G.',
    note: `Cut from a review on Amy's PUBLIC Google Business profile, which is
             not the same thing as written permission to feature it on her own
             site. Permission to publish this specific quote at launch is still
             pending confirmation (BUILD-PLAN.md decision 4).
             First in the rotation on purpose: it is the one piece of
             trade-level proof in the set, so it is the quote present at page
             load and the only one shown under reduced motion. Not shortened
             further — "on the seams" is what makes it specific rather than
             another attention-to-detail line.`,
  },
  {
    quote: 'Even though I was satisfied, she felt it needed a bit more cushioning.',
    attribution: 'Heather L.',
    note: `Same holding pattern and same source as the others: a PUBLIC review,
             not written permission (BUILD-PLAN.md decision 4).
             Cut from a long two-project review. This sentence was chosen over
             the more quotable "Amy is creative, detail-oriented, and truly
             cares about her craft," which is the kind of generic praise the
             selection rule for this section rejects. The fragment kept is the
             only line in the set where the client says the work was already
             good enough for her and Amy redid it anyway — that is a claim
             about standards that no adjective can make. Verbatim.`,
  },
  {
    // A literal ellipsis character, NOT `&hellip;`. Diane K.'s quote is an
    // entity because it is written as an HTML attribute in the template, where
    // Astro decodes it; these are plain JS strings passed through an
    // expression, so an entity would render as the literal text "&hellip;".
    quote: '…designed and installed her gorgeous work.',
    attribution: 'Jenny H.',
    note: `Same holding pattern and same source (BUILD-PLAN.md decision 4).
             Verbatim tail of one sentence, elided at the front the same way
             Diane K.'s is. Chosen over "Her attention to detail is unmatched,"
             which is generic, and over the fabric-options clause, which is
             about the consultation rather than the craft. "Designed and
             installed" is a client independently describing the exact
             design-fabricate-install combination DESIGN_BRIEF section 1 calls
             Amy's actual differentiator, which is worth more than praise.`,
  },
  {
    quote: 'The design is beautiful and color came out perfect.',
    attribution: 'Lisa C.',
    note: `Same holding pattern and same source: a PUBLIC Google review, not
             written permission (BUILD-PLAN.md decision 4).
             Verbatim apart from two things. The original ends with a pink
             heart emoji, removed under 3.2's outright ban on emoji. And the
             fragment is cut from a longer review whose first sentence names
             the piece ("just completed a bathroom valance for me") — the
             sentence kept is the one about the result rather than the object,
             so it does not read as a duplicate of the spec blocks. "color came
             out perfect" is her wording, not "the color"; left uncorrected
             because tidying a quote is still editing it.`,
  },
];

// Hero photograph — swapped in step 10a (2026-08-01) at Sam's request, from
// `ivory-house-hero` to `banded-roman-shade`. This is the wide room frame
// that was the full-bleed lead image on /about until this change: drapery
// and a banded roman shade on a wall of French doors opening onto the pool
// and patio. /about is now deliberately left with no lead image rather than
// having something arbitrary substituted in (see about.astro).
//
// **If this is the wrong frame, the other candidate is
// `photos['pleated-drapery']`** — `hero/pleated-drapery-living-room-french-
// doors-pool-view.jpg`, the same room shot wider, currently the lead on
// /services and /services/drapery and the lead image on the Collected Living
// Room project page. It was NOT on /about, which is what settled it. One
// key change here swaps to it.
//
// Still a single-item array. The array shape stays reversible for a real
// multi-image gallery later; that remains a separate decision.
const heroImages = [
  {
    src: photos['banded-roman-shade'].image,
    // Hero-specific alt rather than photos.ts's shared string: this frame
    // renders as a much wider crop here (a full-screen 100svh box) than it
    // does in the 4:5 and 16/9 slots the shared alt was written for, so the
    // pool and patio beyond the doors are a real part of what is visible.
    alt: 'A living room wall of French doors dressed with pleated drapery and a banded roman shade, opening onto a pool and stone patio, with a crystal chandelier overhead',
    blurDataURL: photos['banded-roman-shade'].blurDataURL,
  },
];

---

<Base
  title="Custom Window Treatments Cincinnati | Amy K Clark Design"
  description="Custom drapery, blinds and shades, and upholstery for Cincinnati and Northern Kentucky homes, designed, made, and installed by Amy Clark."
  ogImage="/images/og/og-default.jpg"
  localBusiness={true}
>
  <h1 class="visually-hidden">
    Custom Window Treatments, Drapery, and Shades in Cincinnati and Northern Kentucky
  </h1>

  <HeroGallery images={heroImages} />

  {/* Section order, 2026-07-31 review: Portfolio -> Services -> About. The
      page leads with the work, not with who made it. The differentiator block
      below is the About section and now sits after Services, where it reads
      as the explanation for what you have just looked at rather than as a
      preamble to it. */}
  <PortfolioStrip projects={projects} />

  <ServiceList services={services} />

  {/* About / the differentiator (5.1 section 4). Restructured 2026-08-01
      (step 10g): copy left, portrait right, collapsing to one column below
      900px. DOM order is copy then portrait, so a screen reader meets the
      section's actual content before the image. */}
  <section class="section wrap differentiator" aria-labelledby="differentiator-heading">
    <p class="type-label section-eyebrow">About</p>

    <div class="differentiator__grid">
      <div class="differentiator__copy">
        <h2 id="differentiator-heading" class="type-display differentiator__heading">
          A Designer's Eye, A Workroom's Understanding
        </h2>
        <!-- DRAFT COPY - NEEDS REWRITE -->
        <p class="differentiator__body">
          Amy designs your window treatments, makes them in her own workroom, and installs them
          herself. All three, one person. An interior decorator does not make anything, and that is
          the whole difference.
        </p>
      </div>

      <!-- =====================================================================
           PORTRAIT PLACEHOLDER — AWAITING KELSEE ETMANS' HEADSHOT.
           This slot is sized and positioned exactly as the real portrait will
           be (4:5, right column, capped at 24rem). Replace the tinted block
           with a <RevealImage> carrying the real photo and its blur-up string,
           and delete the .differentiator__portrait-slot rules. Tracked in
           LAUNCH_CHECKLIST.md §1 and IMAGE-MANIFEST.md's asset requests.

           **FLAG FOR SAM — a real headshot of Amy already exists in this
           repo.** `src/assets/images/team/amy-clark.jpg` is a 1600x1072
           professional portrait against white brick (landed 2026-07-27, see
           BUILD-PLAN) and it is live right now in the Studio row on /about.
           The instruction for this step said there is no headshot yet and to
           build a placeholder, so a placeholder is what this is — but if that
           was about Kelsee's shoot specifically rather than about no photo
           existing at all, dropping the existing file in here is a one-line
           change and this comment can go with it.
           ===================================================================== -->
      <figure class="differentiator__portrait">
        <div class="placeholder-slot differentiator__portrait-slot">
          <span class="type-label">Portrait placeholder — awaiting Kelsee's headshot</span>
        </div>
        <figcaption class="differentiator__portrait-caption">
          <p class="type-label">Amy Clark</p>
          <p class="type-label differentiator__portrait-role">Founder</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap testimonial" aria-labelledby="testimonial-heading">
    {/* Visible heading, and deliberately not the word "testimonials"
        (5.1, 2026-07-31 review) — that names the marketing device rather
        than the thing, and reads as permission to skip. */}
    <h2 id="testimonial-heading" class="type-label section-eyebrow testimonial__heading">
      What Our Clients Say About Working With Us
    </h2>
    <ul class="testimonial__list">
      <li>
        <!-- Attribution format ("Diane K.") approved by Amy — her full name is
             already public on her own Instagram, so first name + last initial
             isn't a new disclosure. Written permission to publish THIS quote
             live at launch is still pending confirmation (BUILD-PLAN.md
             decision 4) — the format is settled, publishing it is not. -->
        <Quote quote="&hellip;made my house into a home." attribution="Diane K." />
      </li>
      <li>
        <!-- ROTATING SLOT. 5.1 (amended 2026-07-27): two quotes visible at
             once, and this second slot cross-dissolves through several real
             ones on 6.1's timing. Interpretation call, BUILD-PLAN.md.
             The permission holding pattern applies to EVERY quote in the
             rotation, not just the first — each carries its own note below.
             Quotes are ordered so the strongest trade detail (Kelly G.) is
             the one present at page load and under reduced motion. -->
        <QuoteRotator quotes={rotatingQuotes} />
      </li>
    </ul>
  </section>

  <ContactBand />
</Base>

<style>
  /* ---- Home-scoped vertical rhythm (3.5's exception, 2026-07-31 review).
     3.5's 160px/96px section spacing was measured on this page and judged too
     generous *here specifically*: the gaps were tall enough that a reader hit
     a screen with nothing on it and read that as the end of the page rather
     than as a pause between sections.

     Scoped with `:global` to Home's own sections rather than changed on the
     `--space-section` token, because the token is right everywhere else —
     long-form text pages (the four service children, About, Process, both
     location pages) still want the full measure, and the brief's "if it feels
     too sparse, it is close to right" still governs them. Roughly 0.65x. ---- */
  :global(main > .section) {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  /* Copy left, portrait right (step 10g). One column below 900px, which is
     the same breakpoint the nav switches at — one number for "this viewport
     is wide enough for two things side by side," rather than a second one
     invented here. The portrait column is capped at 24rem and pushed to the
     right edge, so at 1280px it stays a portrait rather than becoming a
     440px-wide slab, and the heading keeps enough width not to wrap into a
     column of single words. */
  .differentiator__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .differentiator__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
    .differentiator__portrait {
      justify-self: end;
      max-width: 24rem;
      width: 100%;
    }
  }

  .differentiator__heading {
    max-width: 18ch;
  }
  .differentiator__body {
    margin-top: 1.5rem;
  }

  /* 4:5, matching every other portrait-shaped image on the site (the
     portfolio cards, the journal cards, ServiceList's hover stage). */
  .differentiator__portrait-slot {
    aspect-ratio: 4 / 5;
  }
  .differentiator__portrait-caption {
    margin-top: 1rem;
  }
  .differentiator__portrait-role {
    margin-top: 0.5rem;
    color: var(--ink-muted);
  }

  .testimonial__heading {
    margin-bottom: 3rem;
  }

  /* Two quotes, the maximum 5.1 allows. Plain list, no cards, no rules, no
     avatars — the only thing separating them is space. The second sits lower
     than the first at desktop, which is 3.5's "asymmetry over grids" using the
     offset device the portfolio strip already established, not a new one. */
  .testimonial__list {
    display: grid;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .testimonial__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
      align-items: start;
    }
    .testimonial__list > li:nth-child(2) {
      margin-top: 5rem;
    }
  }
</style>
