---
// Process (DESIGN_BRIEF.md 5.5). Four numbered steps, in the brief's exact
// order and with its exact step names. This is the only page on the site
// where numbering is permitted (3.6), which is why StepList.astro exists and
// is used nowhere else.
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/process.md is now
// the one file to edit for this page's title, meta, lead, and all four
// steps. No markdown body: this page's only content is the numbered list,
// which is structured data (title + body per step), not free prose.
//
// **The consultation fee is deliberately not mentioned here.** 5.7 requires
// the "paid in-home visit" paragraph on the Contact page and sets strict
// rules around it (no amount until Amy confirms it, no claim that it credits
// toward the project, no apologising for it). The brief does not ask for it
// on this page, and rule 1 treats cost framing strictly, so step 1 below
// describes what the visit is without touching what it costs. Contact
// (step 6) is where that paragraph lands.
//
// Image (IMAGE-MANIFEST.md standing rule): the workroom shot is the only real
// photo of Amy actually making something, which is what this page is about.

import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import RevealImage from '../components/RevealImage.astro';
import StepList from '../components/StepList.astro';
import { getEntry } from 'astro:content';
import leadImage from '../assets/images/about/amy-hand-stitching-check-fabric-ottoman-cutting-table.jpg';

const entry = await getEntry('pages', 'process');
const { seoTitle, description, eyebrow, title, lead, steps } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Process', href: '/process' },
  ]}
>
  <section class="section wrap text-page__intro">
    <p class="type-label text-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display text-page__heading">{title}</h1>
    {lead.map((paragraph) => <p class="text-page__lead">{paragraph}</p>)}
  </section>

  <RevealImage
    src={leadImage}
    alt="Amy's hands stitching a check-fabric ottoman on the workroom's gridded cutting table"
    blurDataURL="data:image/webp;base64,UklGRrQAAABXRUJQVlA4IKgAAAAQBQCdASoUABsAPtFWpk2oJCOiMBgIAQAaCUAWI+0YM6xTv/HqJLEODA5eoh4khh+AAP6A1FH/ibcZQuuEMg5Bb9qgUg+8MTeydH5d/BbmERZiGbJsiLRQ2+PUcm+DG+P8NtdDhDZFf1313HfX7lH3WkmsrO1kjqlzEbGk6qNAbfKC94avLNB3OZpndDKKEQGcZKeQXRVS3MhjogZaVWt6+6UBmAAAAAA="
    aspectRatio="16/9"
    sizes="100vw"
  />

  <section class="section wrap">
    <StepList steps={steps} />
  </section>

  <ContactBand />
</Base>
