---
// Process (DESIGN_BRIEF.md 5.5 + 5.9).
//
// REWORKED 2026-10-08 (COPY-PASS-V1, Task 7), Kristen's copy pass: four steps
// (01-04) replace the five described below, the stitching close-up is gone,
// and the page is copy left, one image right (the ivory drapery and white
// wood blinds bay-window breakfast room, freed up by the About change),
// image above copy on mobile. The page's own closing heading and paragraph
// replace "Let's Get Started" here only, ahead of the existing discovery-call
// button. Kristen's draft labelled that button "consultation"; the
// consultation is the paid visit, so it keeps the discovery-call label.
//
// Notes below this line describe the page before that pass.
// This is the only page on the site
// where numbering is permitted (3.6), which is why StepList.astro exists and
// is used nowhere else.
//
// **Five numbered steps as of 2026-08-01 (step 10d), not 5.5's four.** The
// page opened at "Consultation" and never named the complimentary discovery
// call, so nothing on it conveyed that 5.9's two-step funnel exists or that
// the call and the consultation are two different things that both happen.
// Steps 1 and 2 are now those two conversations, under their full names;
// 5.5's other three step names are unchanged. The reasoning, and the standing
// no-fee rule that governs how they are described, live in process.md's own
// frontmatter comments — that is the file to edit, not this one.
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/process.md is now
// the one file to edit for this page's title, meta, lead, and all four
// steps. No markdown body: this page's only content is the numbered list,
// which is structured data (title + body per step), not free prose.
//
// **The consultation fee is deliberately not mentioned here, and neither is
// any other cost framing.** 5.7 requires the "paid in-home visit" paragraph
// on the Contact page and sets strict rules around it (never an amount, no
// claim that it credits toward the project, no apologising for it). The brief
// does not ask for that paragraph on this page and rule 1 treats cost framing
// strictly, so the two booking steps below are distinguished by
// "complimentary" (5.9's own word, and the site's CTA wording), by place, and
// by length — never by what either one costs. Contact is where the paid
// in-home visit is described as such.
//
// Image (IMAGE-MANIFEST.md standing rule): the workroom shot is the only real
// photo of Amy actually making something, which is what this page is about.

import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import RevealImage from '../components/RevealImage.astro';
import StepList from '../components/StepList.astro';
import { getEntry } from 'astro:content';
import { photos } from '../data/photos';

const entry = await getEntry('pages', 'process');
const { seoTitle, description, eyebrow, title, lead, steps = [], closing } = entry.data;
const image = photos['ivory-house-bay-window'];
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Process', href: '/process' },
  ]}
>
  <section class="section wrap process-page">
    <div class="process-page__copy">
      <p class="type-label text-page__eyebrow">{eyebrow}</p>
      <h1 class="type-display text-page__heading">{title}</h1>
      {lead.map((paragraph) => <p class="text-page__lead">{paragraph}</p>)}
      <div class="process-page__steps">
        <StepList steps={steps} />
      </div>
    </div>

    <figure class="process-page__image">
      <RevealImage
        src={image.image}
        alt={image.alt}
        blurDataURL={image.blurDataURL}
        aspectRatio="4/5"
        sizes="(min-width: 900px) 30rem, 90vw"
        loading="eager"
      />
    </figure>
  </section>

  {closing ? <ContactBand heading={closing.heading} body={closing.body} /> : <ContactBand />}
</Base>

<style>
  /* Copy left, image right from 900px (the site's two-column breakpoint);
     image above copy below it. The image is second in the DOM so a screen
     reader meets the steps first; `order` lifts it on mobile only. */
  .process-page {
    display: grid;
    gap: 2.5rem;
  }
  .process-page__image {
    order: -1;
    max-width: 30rem;
    width: 100%;
  }
  .process-page__steps {
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .process-page {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
    .process-page__image {
      order: 0;
    }
  }
  /* Image-first below 900px, and below 768px the section's 72px top padding
     only just equals the fixed nav's height, which left the photo pressed
     against the nav. A text-first page reads fine flush; a photo does not. */
  @media (max-width: 767px) {
    .process-page {
      padding-top: calc(var(--space-section) + 1.5rem);
    }
  }
</style>
