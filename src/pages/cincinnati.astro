---
// Location page (DESIGN_BRIEF.md section 4). Exists for search, lives in the
// footer rather than the main nav, and **does not conflict with the
// no-geography project-naming rule** — section 4 says so explicitly. Project
// names stay placeless for brand reasons; the site still has to be findable.
// Nothing on this page names a project, a client, or an address.
//
// Keyword target (8.3): "window treatments Cincinnati OH" — title, H1, first
// paragraph, meta description. Once each, per 8.3's own "do not stuff" rule.
//
// Neighbourhoods (8.4): the brief's instruction is to name the areas
// *naturally within the two location pages*, and explicitly NOT to build
// twelve thin doorway pages, which Google penalises. The Cincinnati-side
// names from 8.4's list appear here; the Kentucky-side ones are on
// /northern-kentucky, so neither page is a duplicate of the other.
//
// **Nothing here claims a project in a named neighbourhood.** The brief
// establishes these as where Amy's clients are concentrated, which supports
// naming them as ground she covers — it does not establish a finished job on
// any particular street, and inventing one would break rule 4 and be untrue.
// **The neighborhood list itself has never been confirmed with Amy as
// accurate** — flagged in ASK-AMY.md.
//
// Vendor naming: rule 8's "the lines I represent." Lafayette is named on its
// own page only. No pricing language (rule 1).
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/cincinnati.md is
// now the one file to edit for this page's title, meta, lead, and body prose.
//
// Image: real Ivory House shoot photography (Phase 3, 2026-07-29), replacing
// the substitute crop this page ran on since step 7. See IMAGE-MANIFEST.md.

import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import RevealImage from '../components/RevealImage.astro';
import { photos } from '../data/photos';
import { getEntry, render } from 'astro:content';

const lead = photos['ivory-house-reading-nook'];
const entry = await getEntry('pages', 'cincinnati');
const { Content } = await render(entry);
const { seoTitle, description, eyebrow, title, lead: leadParagraphs } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Cincinnati', href: '/cincinnati' },
  ]}
>
  <section class="section wrap text-page__intro">
    <p class="type-label text-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display text-page__heading">{title}</h1>
    {leadParagraphs.map((paragraph) => <p class="text-page__lead">{paragraph}</p>)}
  </section>

  <RevealImage
    src={lead.image}
    alt={lead.alt}
    blurDataURL={lead.blurDataURL}
    aspectRatio="16/9"
    sizes="100vw"
  />

  <section class="section wrap">
    <div class="prose">
      <Content />
    </div>
  </section>

  <ContactBand />
</Base>
