---
// DESIGN_BRIEF.md 5.3: own title, meta description, H1, and 400-700 words of
// real copy. Keyword cluster (8.3): "custom drapery Cincinnati, custom
// curtains Cincinnati" — in title, H1, first paragraph, and meta description,
// and nowhere else (8.3's own "do not stuff" rule).
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/drapery.md is now
// the one file to edit for this page's title, meta, lead, and body prose.
//
// Vendor naming, resolved 2026-07-26 (BUILD-PLAN.md decision 11): **Schumacher
// is the only fabric house cleared for public naming.** Amy confirmed Stout and
// Pollack are real lines she carries but are NOT yet cleared to be named
// publicly, pending her rep calls — so they use rule 8's "the lines I
// represent" phrasing here and must not be named on any public page. Rule 7
// lists all three; that is a statement of which lines she carries, not a
// clearance to print them, and rule 8 governs until each rep confirms.
// No pricing language anywhere (rule 1).

// **No lead image as of 2026-08-02, deliberately.** This page led on
// `hero/pleated-drapery-living-room-french-doors-pool-view.jpg`, which is now
// the homepage hero, and the same photograph opening both Home and the
// drapery page reads as a shortage rather than as a motif. Nothing was
// substituted, on Sam's explicit instruction — see services/index.astro for
// the same note and the same reasoning. This is the drapery page and it wants
// a real drapery lead more than any other page on the site; it is first in
// line when Kelsee delivers.

import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'drapery');
const { Content } = await render(entry);
const { seoTitle, description, eyebrow, title, lead } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
    { name: title, href: '/services/drapery' },
  ]}
>
  <section class="section wrap service-page__intro">
    <p class="type-label service-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display service-page__heading">{title}</h1>
    {lead.map((paragraph) => <p class="service-page__lead">{paragraph}</p>)}
  </section>

  {/* The full-bleed lead image that used to sit here is gone — see the header
      comment. It is not replaced. */}

  <section class="section wrap">
    <div class="prose">
      <Content />
    </div>
  </section>

  <ContactBand />
</Base>
