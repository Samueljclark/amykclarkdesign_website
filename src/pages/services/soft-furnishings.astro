---
// DESIGN_BRIEF.md 5.3. Keyword cluster (8.3): "custom pillows and cushions
// Cincinnati" — title, H1, first paragraph, meta description. Site
// architecture (4) names this page "Pillows, Cushions and Soft Furnishings";
// nav and the services list use the shorter "Soft Furnishings" (5.1's own
// wording for the Home entry), so the H1 here carries the full phrase.
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/soft-furnishings.md
// is now the one file to edit for this page's title, meta, lead, and body
// prose (including the inline link to /signature-pieces in its last section).
//
// Placeholder image per the IMAGE-MANIFEST.md standing rule: the living-room
// detail crop is the only real photo showing pillows in place. Swap when
// Kelsee's shoot lands.

import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import RevealImage from '../../components/RevealImage.astro';
import { getEntry, render } from 'astro:content';
import leadImage from '../../assets/images/portfolio/collected-living-room/banded-roman-shade-drapery-french-doors-detail.jpg';

const entry = await getEntry('pages', 'soft-furnishings');
const { Content } = await render(entry);
const { seoTitle, description, eyebrow, title, lead } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
    { name: 'Soft Furnishings', href: '/services/soft-furnishings' },
  ]}
>
  <section class="section wrap service-page__intro">
    <p class="type-label service-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display service-page__heading">{title}</h1>
    {lead.map((paragraph) => <p class="service-page__lead">{paragraph}</p>)}
  </section>

  <RevealImage
    src={leadImage}
    alt="Banded roman shade and pleated drapery framing French doors, with a crystal chandelier overhead"
    blurDataURL="data:image/webp;base64,UklGRqwAAABXRUJQVlA4IKAAAAAwBQCdASoYABUAPu1orlCppaQiqAqpMB2JZwAG0KCFeA8GvwPjvP6bHUT+YIQzyU7j0AD+FSHDV0ubeTAPHbf5413BYJW3pLc2ZHNK0MCBuh5vMwaNlvdw15DG9e1iBJcqwHR2FKUtXrkLqItBnK/DhKwBxjlP+OnZmgp6tjAHPHdy98FzAZDZkNeAJofae+wgRZ+DQT6E0ZUr/QTv/QAA"
    aspectRatio="16/9"
    sizes="100vw"
  />

  <section class="section wrap">
    <div class="prose">
      <Content />
    </div>
  </section>

  <ContactBand />
</Base>
