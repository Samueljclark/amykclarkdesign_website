---
// DESIGN_BRIEF.md 5.3 — the growth category, "needs the most attention."
// Lafayette Interior Fashions is named here and only here (rule 8 reserves
// the name for this page; Home and the services overview use "the lines I
// represent"). No logo or trademark is used, per rule 8.
//
// Naming Lafayette as the source is what rule 7 and 8.3 ask for. A formal
// relationship claim is not: the page said "Amy is a Lafayette Interior
// Fashions dealer" until 2026-07-26, which is an unconfirmed factual claim
// about a business relationship (BUILD-PLAN decision 12). Softened to "the one
// line I represent in this category," matching the holding pattern Stout and
// Pollack are already under. Restore the dealer wording only once Amy
// confirms it.
//
// Keyword cluster (8.3): "custom blinds Cincinnati, custom shades Northern
// Kentucky, Lafayette blinds Cincinnati" — title, H1, first paragraph, meta
// description.
//
// Roman shades appear as a searchable term but route to manufactured
// product, not Amy's workroom (5.3's own instruction) — src/content/pages/
// blinds-shades.md's second lead paragraph says so explicitly.
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — that one markdown file holds the
// title, meta, lead, the five accordion categories, AND the "An eighth of an
// inch" body prose. The accordion categories are structured frontmatter
// there, not markdown body, because a plain paragraph can't become five
// independent accordion panels without a parsing layer — see that file's
// own header comment.

import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import RevealImage from '../../components/RevealImage.astro';
import Accordion from '../../components/Accordion.astro';
import { getEntry, render } from 'astro:content';
import leadImage from '../../assets/images/portfolio/collected-living-room/banded-roman-shade-drapery-french-doors-detail.jpg';

const entry = await getEntry('pages', 'blinds-shades');
const { Content } = await render(entry);
const { seoTitle, description, eyebrow, title, lead, decisionCategoriesHeading, decisionCategoriesIntro, decisionCategories } =
  entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
    { name: title, href: '/services/blinds-shades' },
  ]}
>
  <section class="section wrap service-page__intro">
    <p class="type-label service-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display service-page__heading">{title}</h1>
    {lead.map((paragraph) => <p class="service-page__lead">{paragraph}</p>)}
  </section>

  <RevealImage
    src={leadImage}
    alt="Banded roman shade and pleated drapery framing French doors, with a crystal chandelier overhead"
    blurDataURL="data:image/webp;base64,UklGRqwAAABXRUJQVlA4IKAAAAAwBQCdASoYABUAPu1orlCppaQiqAqpMB2JZwAG0KCFeA8GvwPjvP6bHUT+YIQzyU7j0AD+FSHDV0ubeTAPHbf5413BYJW3pLc2ZHNK0MCBuh5vMwaNlvdw15DG9e1iBJcqwHR2FKUtXrkLqItBnK/DhKwBxjlP+OnZmgp6tjAHPHdy98FzAZDZkNeAJofae+wgRZ+DQT6E0ZUr/QTv/QAA"
    aspectRatio="16/9"
    sizes="100vw"
  />

  <section class="section wrap service-page__body">
    <h2 class="type-display service-page__subhead">{decisionCategoriesHeading}</h2>
    <p>{decisionCategoriesIntro}</p>

    <Accordion items={decisionCategories} />

    <div class="prose">
      <Content />
    </div>
  </section>

  <ContactBand />
</Base>
