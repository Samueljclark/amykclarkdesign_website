---
// Services overview (DESIGN_BRIEF.md 5.3): "Overview page plus four child
// pages." Reuses ServiceList — the same four entries in the same order as
// Home (5.1), shared via src/data/services.ts — rather than a second,
// near-identical list component. Real visible <h1> here (unlike Home's
// hero-specific visually-hidden one).

// **No lead image as of 2026-08-02, deliberately.** This page led on
// `hero/pleated-drapery-living-room-french-doors-pool-view.jpg`, which is now
// the homepage hero. Running the same photograph as the first image on Home
// and on Services reads as a shortage rather than as a motif. Nothing was
// substituted in its place, on Sam's explicit instruction — every other real
// photograph on this site is already doing three or four jobs, and filling a
// hole with the nearest available frame is how that got as bad as it is.
// The ServiceList below carries four photographs on its hover stage at
// desktop widths, so this page is not imageless in practice.
// Give it a real lead when Kelsee delivers.

import Base from '../../layouts/Base.astro';
import ServiceList from '../../components/ServiceList.astro';
import { services } from '../../data/services';
---

<Base
  title="Services | Amy K Clark Design"
  description="Custom drapery, blinds and shades, upholstery, and soft furnishings for Cincinnati and Northern Kentucky homes, designed, made, and installed by Amy Clark."
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
  ]}
>
  <section class="section wrap services-intro">
    <h1 class="type-display services-intro__heading">Services</h1>
    <p class="services-intro__body">
      Amy handles every part of a window treatment project, from the first walk through the room to
      the day it hangs, in homes throughout Cincinnati and Northern Kentucky. Every project starts
      with your room: its light, its architecture, and how you actually live in it.
    </p>
  </section>

  {/* The full-bleed lead image that used to sit here is gone — see the header
      comment. It is not replaced. */}

  {/* Heading hidden here only: this page's own <h1> already reads "Services"
      and a visible duplicate directly beneath it is a stutter. Home shows it
      visibly (5.1). */}
  <ServiceList services={services} headingHidden={true} />
</Base>

<style>
  .services-intro__heading {
    max-width: 18ch;
  }
  .services-intro__body {
    max-width: var(--measure);
    margin-top: 1.5rem;
  }
</style>
