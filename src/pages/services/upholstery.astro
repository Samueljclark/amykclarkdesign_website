---
// DESIGN_BRIEF.md 5.3. Keyword cluster (8.3): "custom upholstery Cincinnati"
// — title, H1, first paragraph, meta description.
//
// Copy sourced from the `pages` content collection (Phase 2 of the
// copy-bulk-swap work, BUILD-PLAN.md) — src/content/pages/upholstery.md is
// now the one file to edit for this page's title, meta, lead, and body prose.
//
// Placeholder image per the IMAGE-MANIFEST.md standing rule: the workroom
// ottoman-stitching photo is the closest real upholstery-adjacent shot that
// exists (it is literally a check-fabric ottoman on the cutting table). Swap
// when Kelsee's shoot lands.

import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import RevealImage from '../../components/RevealImage.astro';
import { getEntry, render } from 'astro:content';
import leadImage from '../../assets/images/about/amy-hand-stitching-check-fabric-ottoman-cutting-table.jpg';

const entry = await getEntry('pages', 'upholstery');
const { Content } = await render(entry);
const { seoTitle, description, eyebrow, title, lead } = entry.data;
---

<Base
  title={seoTitle}
  description={description}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
    { name: title, href: '/services/upholstery' },
  ]}
>
  <section class="section wrap service-page__intro">
    <p class="type-label service-page__eyebrow">{eyebrow}</p>
    <h1 class="type-display service-page__heading">{title}</h1>
    {lead.map((paragraph) => <p class="service-page__lead">{paragraph}</p>)}
  </section>

  <RevealImage
    src={leadImage}
    alt="Amy's hands stitching a check-fabric ottoman on the workroom's gridded cutting table"
    blurDataURL="data:image/webp;base64,UklGRrQAAABXRUJQVlA4IKgAAAAQBQCdASoUABsAPtFWpk2oJCOiMBgIAQAaCUAWI+0YM6xTv/HqJLEODA5eoh4khh+AAP6A1FH/ibcZQuuEMg5Bb9qgUg+8MTeydH5d/BbmERZiGbJsiLRQ2+PUcm+DG+P8NtdDhDZFf1313HfX7lH3WkmsrO1kjqlzEbGk6qNAbfKC94avLNB3OZpndDKKEQGcZKeQXRVS3MhjogZaVWt6+6UBmAAAAAA="
    aspectRatio="16/9"
    sizes="100vw"
  />

  <section class="section wrap">
    <div class="prose">
      <Content />
    </div>
  </section>

  <ContactBand />
</Base>
