---
// Journal post (DESIGN_BRIEF.md 5.6). Markdown-driven via the `journal`
// content collection.
//
// **5.6's "each post internally links to at least one service page" is enforced
// structurally, not by trusting the prose.** `relatedService` is a required
// enum in content.config.ts and gets rendered as a real link below the body, so
// a post cannot ship without one even if someone later edits the inline links
// out of the markdown. Every post also links inline, which is the link that
// actually carries weight for search.
//
// Article and BreadcrumbList JSON-LD (8.2) are passed to Base.astro as props
// and emitted by JsonLd.astro, which owns every structured-data block except
// FAQPage (that one lives with the questions it describes, in Faq.astro).
//
// Prose styles are `:global()` because Astro's scoped styles do not reach
// markdown rendered through <Content />. The link treatment reproduces 6.6's
// scaleX underline rather than toggling text-decoration, since markdown links
// cannot carry the .link-underline class.

import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import RevealImage from '../../components/RevealImage.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { journalImages } from '../../data/journalImages';
import { services } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const hero = journalImages[post.data.heroImage];
const relatedService = services.find((service) => service.href === post.data.relatedService)!;

const publishedISO = post.data.publishDate.toISOString().slice(0, 10);
const publishedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(post.data.publishDate);
---

<Base
  title={post.data.seoTitle}
  description={post.data.description}
  ogImage="/images/og/og-default.jpg"
  ogType="article"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Design Journal', href: '/journal' },
    { name: post.data.title, href: `/journal/${post.id}` },
  ]}
  article={{
    // `headline` is the on-page H1, not `seoTitle`: schema.org wants the
    // article's actual headline, and seoTitle exists only to fit 8.1's
    // 60-character <title> budget.
    headline: post.data.title,
    description: post.data.description,
    // The verbatim-served master under /public/images/, not the hashed
    // astro:assets variant — a schema image URL should be stable across
    // rebuilds and independent of which srcset width happened to be picked.
    image: hero.publicPath,
    datePublished: publishedISO,
  }}
>
  <article>
    <section class="section wrap text-page__intro">
      <p class="type-label text-page__eyebrow">
        <a href="/journal" class="link-underline">Design Journal</a>
      </p>
      <h1 class="type-display journal-post__heading">{post.data.title}</h1>
      {/* Standfirst, added 2026-08-01 (step 10j). This is the post's existing
          `description` — the same string the journal index already shows
          under each card and the same one that goes in <meta name=
          "description">. Not new copy; it is only newly visible here.

          Why it is here: these pages already passed the scroll-affordance
          check on the letter of it (measured at 1280x800 — eyebrow, title and
          date are all above the fold, with the lead image cut off by the fold
          behind them). What they did badly was the spirit. The lead image is
          a full-bleed 16/9, which at 1280px is 720px tall, so the first line
          of actual prose sat 880px below the title and a reader had nothing
          telling them what the post was about before committing to that
          scroll. One line of summary is the cheapest thing that fixes it. */}
      <p class="journal-post__standfirst">{post.data.description}</p>
      <p class="type-label journal-post__date">
        <time datetime={publishedISO}>{publishedLabel}</time>
      </p>
    </section>

    <RevealImage
      src={hero.image}
      alt={hero.alt}
      blurDataURL={hero.blurDataURL}
      aspectRatio="16/9"
      sizes="100vw"
      transitionName={`journal-photo-${post.id}`}
    />

    <section class="section wrap">
      <div class="prose">
        <Content />
      </div>

      <aside class="journal-post__related">
        <p class="type-label journal-post__related-label">Related service</p>
        <p class="journal-post__related-link">
          <a href={relatedService.href} class="link-underline">{relatedService.name}</a>
        </p>
      </aside>
    </section>
  </article>

  <ContactBand />
</Base>

<style>
  .journal-post__heading {
    /* Post titles are sentences, not two-word page names, so they need a wider
       measure than .text-page__heading's 18ch and a smaller point size than the
       full Display clamp. Same Display role, page-appropriate range. */
    font-size: clamp(1.875rem, 1.4rem + 1.9vw, 3.25rem);
    max-width: 34ch;
  }

  .journal-post__standfirst {
    max-width: var(--measure);
    margin-top: 1.5rem;
  }

  .journal-post__date {
    margin-top: 1.5rem;
    color: var(--ink-muted);
  }

  /* Rendered markdown body: `.prose` and its h2/p/list/link treatment now
     live in global.css (Phase 2 of the copy-bulk-swap work), shared with
     every other markdown-driven page. Nothing journal-specific left here. */

  .journal-post__related {
    max-width: var(--measure);
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .journal-post__related-label {
    color: var(--ink-muted);
  }

  .journal-post__related-link {
    margin-top: 1rem;
  }
</style>
