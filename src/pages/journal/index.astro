---
// Design Journal index (DESIGN_BRIEF.md 5.6). Three real posts at launch, all
// drafted from the brief's own listed topics and flagged in each .md file as
// pending Amy's review.
//
// This page is the one deliberate exception to Amy's "they are not there to
// read" rule (section 1), and it is a narrow one: the journal exists for search
// (8.x), so the index still has to be scannable rather than a wall of text.
// Each entry is a photo, a title, and the one-line description that is already
// doing duty as the post's meta description — nothing is written twice.
//
// Ordered newest first. Dates are placeholders until launch, flagged in
// BUILD-PLAN.md step 6.

import Base from '../../layouts/Base.astro';
import RevealImage from '../../components/RevealImage.astro';
import { getCollection } from 'astro:content';
import { journalImages } from '../../data/journalImages';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title="Design Journal | Amy K Clark Design"
  description="Notes on fabric, drapery, blinds, and shades from Amy Clark, who designs, makes, and installs them in Cincinnati and Northern Kentucky."
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Design Journal', href: '/journal' },
  ]}
>
  <section class="section wrap">
    <p class="type-label text-page__eyebrow">Design Journal</p>
    <h1 class="type-display journal-index__heading">Design Journal</h1>
    <p class="text-page__lead">
      What Amy has learned making window treatments, written down. How to read a fabric, how to
      choose between drapery and shades room by room, and the details that decide whether a
      treatment looks finished.
    </p>

    <ul class="journal-index__list">
      {posts.map((post) => {
        const hero = journalImages[post.data.heroImage];
        return (
          <li class="journal-index__item">
            <article class="journal-index__entry">
              <a href={`/journal/${post.id}`} class="journal-index__link">
                <RevealImage
                  src={hero.image}
                  alt={hero.alt}
                  blurDataURL={hero.blurDataURL}
                  aspectRatio="4/5"
                  sizes="(min-width: 768px) 40vw, 90vw"
                  transitionName={`journal-photo-${post.id}`}
                />
                <div class="journal-index__meta">
                  <p class="type-label journal-index__date">
                    <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
                      {dateFormatter.format(post.data.publishDate)}
                    </time>
                  </p>
                  <h2 class="journal-index__title">
                    <span class="link-underline">{post.data.title}</span>
                  </h2>
                </div>
              </a>
              <p class="journal-index__description">{post.data.description}</p>
            </article>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  .journal-index__heading {
    max-width: 18ch;
  }

  /* ---- Layout replaced 2026-08-01 (step 10h). ----
     This list used to run the same progressive stagger as the services list:
     `nth-child(3n+2)` down 4rem and `nth-child(3n+3)` down 2rem, per 3.5's
     "varied vertical offsets." With three entries that means **no two cards
     align with each other** — three different baselines across three items —
     and the eye reads that as a mistake rather than as a composition. It is
     the same failure the portfolio strip had (step 10f), and it is worse
     here, because these three cards are permanently the same kind of object.

     **Chosen: alternating, with the middle entry offset and the outer two
     inline.** The alternative Sam offered was a flat uniform row, and it
     would also have worked; this is stronger for two reasons.

     First, it is *symmetric*. Outer two aligned, middle displaced, is a
     pattern with a centre — a reader resolves it as intent immediately,
     which a progressive stagger never gives them. Three is precisely the
     count where that reads; it is why the alternative was worth having.

     Second, the portfolio grid became uniform in the same batch. If the
     journal went uniform too, every list on the site would be a plain grid
     and 3.5's asymmetry preference would survive nowhere. Keeping one
     deliberate offset, in the one place the item count actually supports it,
     preserves the site's character without reintroducing the scatter.

     Offset is down rather than up (no negative margin, nothing reaching back
     toward the lead paragraph) and it is a single restrained 3rem, replacing
     two different values. It applies only in the three-column layout — in a
     single column an offset is just a larger gap, which reads as a mistake.

     Explicit three columns rather than `auto-fit`: with three items `auto-fit`
     drops to two tracks somewhere around 1000px and orphans the third, which
     breaks the centre the pattern depends on. The old track cap existed to
     work around `auto-fit`'s single-item collapse and is no longer needed. */
  .journal-index__list {
    display: grid;
    gap: 3rem 1.5rem;
    margin-top: 5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .journal-index__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }

  .journal-index__link {
    display: block;
  }

  .journal-index__meta {
    margin-top: 1rem;
  }

  .journal-index__date {
    color: var(--ink-muted);
  }

  /* The subhead size (global.css's .text-page__subhead), not a fourth type
     role — same Display role at the small end of its clamp. */
  .journal-index__title {
    font-weight: var(--weight-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    margin-top: 0.75rem;
  }

  .journal-index__description {
    margin-top: 0.75rem;
    color: var(--ink-muted);
  }

  /* The middle-card offset (3rem, `nth-child(3n + 2)`) is gone as of
     2026-08-19 (post-Meeting-4 pass, Task 8). Kristen's alignment critique:
     staggered and floating elements read as accidental rather than
     intentional, and the instruction was explicit — no two-up-one-down
     patterns anywhere on the site, no exceptions for the ones that happened
     to have a symmetric rationale. All three cards now share one baseline,
     same as the portfolio grid this list used to differ from on purpose. */
</style>
