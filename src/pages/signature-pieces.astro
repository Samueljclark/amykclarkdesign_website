---
// Signature Pieces — INTERPRETATION CALL, not a DESIGN_BRIEF requirement.
// Requested by Sam 2026-07-26 and flagged as such in BUILD-PLAN.md, not in
// DESIGN_BRIEF.md. The brief's site architecture (section 4) does not list
// this page.
//
// **This is a placeholder for eventual real e-commerce. It is not
// e-commerce.** Amy is fine with that framing. There is no cart, no
// quantity, no stock, no checkout, no price, and no "Add to Cart" — 3.2 bans
// the visual language and rule 1 bans the price outright. Each piece links to
// the existing consultation form with the words "Inquire About This," which
// routes an interested reader into the same qualification funnel 5.7 says the
// site exists to feed. **Do not let this drift toward a shop without
// deciding, deliberately, that it should be one.**
//
// Nav: no new top-level item. DESIGN_BRIEF 4 caps the main nav at six and it
// is full. This page is reached from /portfolio and from
// /services/soft-furnishings, and it is in the sitemap.
//
// The "Inquire About This" links go to /contact plainly, with no query
// parameter. Pre-selecting the Soft Furnishings checkbox from a query string
// would need a client-side script inside ConsultationForm.astro, which
// already carries hand-written `setCustomValidity` logic for that same
// checkbox group — that is real plumbing on a verified form, not a free win,
// so it was not done. Recorded in BUILD-PLAN.md as an option, not a gap.
//
// Photography: the two pillow photos are the ONLY non-placeholder images on
// the site (IMAGE-MANIFEST.md). Two pieces exist, so two ship. Nothing is
// padded.

import Base from '../layouts/Base.astro';
import RevealImage from '../components/RevealImage.astro';
import { photos } from '../data/photos';
import { signaturePieces } from '../data/signaturePieces';
---

<Base
  title="Signature Pieces | Amy K Clark Design"
  description="Pillows Amy K Clark has made and can make again: woven tapestry and textured patterns, finished with hand-set contrast piping."
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Portfolio', href: '/portfolio' },
    { name: 'Signature Pieces', href: '/signature-pieces' },
  ]}
>
  <section class="section wrap text-page__intro">
    <p class="type-label text-page__eyebrow">
      <a href="/portfolio" class="link-underline">Portfolio</a>
    </p>
    <h1 class="type-display text-page__heading">Signature Pieces</h1>
    <p class="text-page__lead">
      Pieces I have made, photographed as they were finished. Each one started as a length of cloth
      and a decision about how to edge it. If one of them is right for your room, I can make it
      again, in this fabric or in another.
    </p>
  </section>

  <ul class="pieces">
    {signaturePieces.map((piece) => {
      const photo = photos[piece.photo];
      return (
        <li class="pieces__item" id={piece.slug}>
          <RevealImage
            src={photo.image}
            alt={photo.alt}
            blurDataURL={photo.blurDataURL}
            aspectRatio="4/3"
            sizes="(min-width: 900px) 55vw, 100vw"
            class="pieces__figure"
          />
          <div class="pieces__text">
            <h2 class="type-display pieces__name">{piece.name}</h2>
            <p class="pieces__desc">{piece.description}</p>
            <a href="/contact" class="btn btn-outline pieces__cta">
              Inquire About This<span class="visually-hidden"> — {piece.name}</span>
            </a>
          </div>
        </li>
      );
    })}
  </ul>

  <section class="section wrap text-page__body">
    <h2 class="type-display text-page__subhead">Made again, not stocked</h2>
    <p>
      Nothing here sits in a box waiting to ship. Each piece gets made when it is asked for, which
      is why the conversation starts with your room rather than with a button. Tell me which one
      caught your eye and what it would be sitting on, and I will tell you whether that fabric is
      right for it.
    </p>
    <p>
      More on the rest of this category on the
      <a href="/services/soft-furnishings" class="link-underline">soft furnishings</a> page.
    </p>
  </section>

  <section class="section wrap contact-band bg-ground">
    <p class="type-display contact-band__line">Ready to start your project?</p>
    <a href="/contact" class="btn btn-solid">Schedule a Consultation</a>
  </section>
</Base>

<style>
  /* Deliberately not a product grid. Each piece gets a full row: photograph
     large on one side, a name and a few lines on the other, alternating
     sides so the page reads as a sequence of objects rather than as
     inventory. No card, no border, no shadow, no radius (3.2). */
  .pieces {
    display: grid;
    gap: var(--space-section);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    padding-block-end: var(--space-section);
  }

  .pieces__item {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .pieces__name {
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 3rem);
  }

  .pieces__desc {
    margin-top: 1rem;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .pieces__cta {
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .pieces__item {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
    /* Alternate which side the photograph sits on, per 3.5's preference for
       asymmetry over a uniform grid. */
    .pieces__item:nth-child(even) .pieces__figure {
      grid-column: 2;
      grid-row: 1;
    }
    .pieces__item:nth-child(even) .pieces__text {
      grid-column: 1;
      grid-row: 1;
    }
    .pieces__item:nth-child(even) {
      grid-template-columns: 1fr 1.4fr;
    }
  }
</style>
