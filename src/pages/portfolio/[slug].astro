---
// Project detail template (DESIGN_BRIEF.md 5.2): lead image, supporting
// images, a short paragraph stating Amy's scope explicitly ("so the site
// never implies she designed the whole house"), and a spec block. Real <h1>
// is the project name — no visually-hidden-H1 pattern here, that was Home's
// hero-specific workaround for its own "no headline block" rule (5.1), which
// doesn't apply on this page.
//
// **The title block moved above the lead image, 2026-08-01 (step 10j).** The
// page used to open on a full-bleed 16/9 photograph with the H1 below it and
// below the collage. Measured at 1280x800, that put **zero words** in the
// first viewport on both project pages — 88% and 90% of the screen was
// photograph and nothing on it said the page continued. That is precisely
// Kristen Hitch's structural note from the July 31 review ("the site assumes
// people will scroll and they will not"), and it is now a standing
// requirement in DESIGN_BRIEF: no page may present only a photograph above
// the fold.
//
// The shape now matches the journal post template exactly — eyebrow that
// links back to the index, H1, then the image — so this is the site's one
// pattern for "an article-shaped page", not a second one. The blurb, scope
// line, and spec block stay below the collage where they were.

import Base from '../../layouts/Base.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import SpecBlock from '../../components/SpecBlock.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Base
  title={`${project.name} | Amy K Clark Design`}
  description={project.metaDescription ?? project.scope}
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Portfolio', href: '/portfolio' },
    { name: project.name, href: `/portfolio/${project.slug}` },
  ]}
>
  <article>
    <section class="section wrap text-page__intro">
      <p class="type-label text-page__eyebrow">
        <a href="/portfolio" class="link-underline">Portfolio</a>
      </p>
      <h1 class="type-display project-detail__heading">{project.name}</h1>
    </section>

    <ProjectGallery
      lead={project.lead}
      supporting={project.supporting}
      leadTransitionName={`project-photo-${project.slug}`}
    />

    <section class="section wrap project-detail__body">
      {/* The problem/solution blurb (5.2, 2026-07-31 review), then the scope
          statement. Order matters: the blurb says what the work is, the scope
          line says how much of the room was Amy's — which only makes sense
          once you know what was done.

          `scope` became genuinely optional 2026-08-18 (SITE-COPY-REWRITE.md):
          Collected Living Room's scope line was cut because it repeated the
          blurb's own last sentence ("one credit line is confident, two is
          nervous"). Ivory House keeps its scope line — there the second
          paragraph is doing real disclosure work the blurb doesn't cover.
          Same "don't render what isn't there" pattern SpecBlock.astro already
          uses for `lining`/`hardware`. */}
      <p class="project-detail__blurb">{project.blurb}</p>
      {project.scope && <p class="project-detail__scope">{project.scope}</p>}
      <SpecBlock spec={project.spec} />
    </section>
  </article>
</Base>

<style>
  .project-detail__heading {
    max-width: 18ch;
  }
  /* No top margin any more: the blurb is now the first thing in its own
     section rather than following the H1 directly. */
  .project-detail__blurb {
    max-width: var(--measure);
  }
  /* The scope line sits quieter than the blurb above it: it is a disclosure,
     not the pitch. Muted, same treatment as other meta text (3.3). */
  .project-detail__scope {
    max-width: var(--measure);
    margin-top: 1.25rem;
    margin-bottom: 3rem;
    color: var(--ink-muted);
  }
</style>
