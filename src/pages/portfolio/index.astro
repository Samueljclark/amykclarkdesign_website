---
// Portfolio index (DESIGN_BRIEF.md 5.2): "an asymmetric image list. Project
// name only. No teaser copy." Same asymmetric nth-child treatment as Home's
// PortfolioStrip (3.5), not shared as a component with it — this page has a
// real, visible <h1> and no "View Full Portfolio" CTA (it's already the full
// list), unlike the strip's visually-hidden heading and homepage teaser
// role. Ships with the one real project until Kelsee's photography lands
// (see projects.ts, same flagged shortfall as the Home strip in step 2).

import Base from '../../layouts/Base.astro';
import RevealImage from '../../components/RevealImage.astro';
import { projects } from '../../data/projects';
---

<Base
  title="Portfolio | Amy K Clark Design"
  description="Custom drapery, blinds and shades, and upholstery projects by Amy K Clark Design, Cincinnati and Northern Kentucky."
  ogImage="/images/og/og-default.jpg"
  transparentNav={false}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Portfolio', href: '/portfolio' },
  ]}
>
  <section class="section wrap">
    <h1 class="type-display portfolio-index__heading">Portfolio</h1>

    <ul class="portfolio-index__list">
      {projects.map((project) => (
        <li class="portfolio-index__item">
          <a href={`/portfolio/${project.slug}`} class="portfolio-index__link">
            <RevealImage
              src={project.image}
              alt={project.alt}
              blurDataURL={project.blurDataURL}
              aspectRatio="4/5"
              sizes="(min-width: 768px) 40vw, 90vw"
              transitionName={`project-photo-${project.slug}`}
            />
            <span class="type-label portfolio-index__name">{project.name}</span>
          </a>
        </li>
      ))}
    </ul>

    {/* The /signature-pieces link that used to sit here is gone with the page
        itself (step 9a, 2026-07-31 review). Nothing replaces it: the pillow
        photography lives on /services/soft-furnishings, which is in the nav. */}
  </section>
</Base>

<style>
  .portfolio-index__heading {
    max-width: 18ch;
    margin-bottom: 3rem;
  }

  .portfolio-index__list {
    display: grid;
    gap: 3rem 1.5rem;
    /* The track max is 32rem, not `1fr`, and that matters. With `auto-fit`,
       a `1fr` max is a trap on a single item: auto-fit collapses the empty
       tracks to 0 and the one surviving track absorbs the entire row. At
       1345px that rendered a 1249x1561 image — taller than the viewport, and
       on a short laptop screen roughly two screens tall. Capping the max
       lets one item render at a sane size while three or more still fill the
       row exactly as before. The bug only appears while a collection holds a
       single item, which is the state the portfolio and this gallery are
       actually in today. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 32rem));
  }

  .portfolio-index__link {
    display: block;
  }

  .portfolio-index__name {
    display: inline-block;
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  /* Asymmetry (3.5): same pattern as PortfolioStrip, inert with one item. */
  @media (min-width: 768px) {
    .portfolio-index__item:nth-child(3n+2) {
      margin-top: 4rem;
    }
    .portfolio-index__item:nth-child(3n+3) {
      margin-top: 2rem;
    }
  }
</style>
