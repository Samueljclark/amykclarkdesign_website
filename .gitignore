# Dependencies — restored by `npm ci` from package-lock.json, never committed.
node_modules/

# Build output — regenerated by `npm run build`. Netlify builds this itself.
dist/

# Astro's local cache (content collection types, image transform cache).
.astro/

# Secrets. Nothing in this project uses env vars today; this is here so that
# stays true by accident as well as on purpose. Netlify Forms needs no keys.
.env
.env.*
!.env.example

# macOS / editor noise.
.DS_Store
.Rhistory
*.swp
.idea/
.vscode/

# Netlify CLI local state, if it ever gets used.
.netlify/

# Claude Code's per-machine settings (absolute paths to this Mac, a permission
# allowlist that means nothing elsewhere). `.claude/launch.json` IS committed —
# it is the shared dev-server config.
.claude/settings.local.json

# What is deliberately NOT ignored, because losing it is the actual risk here:
#   source-photos/   untouched camera/phone originals (IMAGE-MANIFEST.md)
#   public/images/   processed masters
#   src/assets/      the astro:assets copies
#   legacy-static/   the archived v1 site, kept for history (CLAUDE.md)
