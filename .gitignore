# Dependencies — restored by `npm ci` from package-lock.json, never committed.
node_modules/

# Build output — regenerated by `npm run build`. Netlify builds this itself.
dist/

# Astro's local cache (content collection types, image transform cache).
.astro/

# Secrets. As of 2026-08-05 this project has exactly ONE secret:
# RESEND_API_KEY, used by netlify/functions/submission-created.js to send the
# two consultation emails. **It is set in the Netlify UI and must never be
# written to a file in this repo.** Netlify Forms itself still needs no keys.
.env
.env.*
!.env.example

# macOS / editor noise.
.DS_Store
.Rhistory
*.swp
.idea/
.vscode/

# Netlify CLI local state, if it ever gets used.
.netlify/

# The Ivory House shoot's full ~27-frame rough-edit set (2026-07-28),
# photographer Kelsee Etmans — 72MB. The photographer's own Drive folder is
# the real archive for the full shoot; this repo tracks only the ten frames
# actually selected, processed, and renamed (public/images/portfolio/
# ivory-house/, src/assets/images/portfolio/ivory-house/). Selection record
# and reasoning: IMAGE-MANIFEST.md. Kept on disk, never deleted — see that
# file's own standing rule against ever deleting real photography — just not
# duplicated into git history at full weight.
source-photos/preeditstardustlnpics/

# Claude Code's per-machine settings (absolute paths to this Mac, a permission
# allowlist that means nothing elsewhere). `.claude/launch.json` IS committed —
# it is the shared dev-server config.
.claude/settings.local.json

# What is deliberately NOT ignored, because losing it is the actual risk here:
#   source-photos/   untouched camera/phone originals (IMAGE-MANIFEST.md)
#   public/images/   processed masters
#   src/assets/      the astro:assets copies
#   legacy-static/   the archived v1 site, kept for history (CLAUDE.md)
